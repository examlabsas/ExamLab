{
  // Panel de administración de ExamLab.
  //
  // Worker aparte del sitio a propósito: si el panel se rompe, el sitio sigue
  // publicándose. Comparten repositorio para que el panel pueda importar los
  // tipos de `src/lib` y no se desincronicen.
  //
  // Antes del primer despliegue hay que rellenar el `id` del espacio de KV y
  // cargar los secretos. Los pasos están en admin/README.md.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "examlab-panel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",

  // La tipografía y el emblema viajan dentro del Worker.
  //
  // Con esta regla, `import x from './algo.woff2'` devuelve un ArrayBuffer que
  // `src/estatico.ts` sirve por su ruta. Es lo que permite que el panel use la
  // Montserrat del sitio sin pedirle nada a nadie de fuera: la cabecera de
  // seguridad sigue siendo `default-src 'self'`, sin excepciones.
  "rules": [{ "type": "Data", "globs": ["**/*.woff2", "**/*.webp", "**/*.png"], "fallthrough": false }],

  // El panel se usa en admin.examlabsas.com y en ningún otro sitio.
  //
  // Sin estas dos líneas Cloudflare lo publica además en
  // examlab-panel.<cuenta>.workers.dev y en una dirección de vista previa por
  // cada despliegue. El propio panel de Cloudflare las describe como «Anyone
  // with this URL can visit»: son la misma pantalla de acceso con otra
  // dirección, y cada una es una puerta más que vigilar y que puede acabar
  // indexada o reenviada por descuido.
  "workers_dev": false,
  "preview_urls": false,

  // Datos de usuarios, sesiones, invitaciones y contador de intentos.
  // El `id` lo devuelve `wrangler kv namespace create PANEL`.
  "kv_namespaces": [
    {
      "binding": "PANEL",
      "id": "53b2712bcc004707aaeeec4b6da05bfd"
    }
  ],

  "vars": {
    // El repositorio donde el panel escribe cada cambio, y la rama.
    "REPO": "examlabsas/ExamLab",
    "RAMA": "main"
  },

  // Secretos — NO van aquí. Se cargan con `wrangler secret put`:
  //   GITHUB_TOKEN   token de permisos mínimos: solo Contents, solo este repositorio
  //
  // Es el único. Aquí figuró un `FIRMA_SESION` «para firmar las cookies» que
  // nunca se usó: la sesión es un testigo opaco en KV, no un token firmado.
  // Pedirlo mandaba a ejecutar un paso inútil y hacía creer que la cookie
  // llevaba una firma que no lleva.
  "observability": {
    "enabled": true
  }
}
