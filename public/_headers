# Cabeceras HTTP que aplica Cloudflare Pages (y Netlify) al servir el sitio.
# Cumple el punto de seguridad de la proforma: cabeceras configuradas y HTTPS
# forzado. Este archivo se copia tal cual a la carpeta publicada.

/*
  # Evita que el navegador "adivine" el tipo de archivo (ataques por MIME).
  X-Content-Type-Options: nosniff
  # No filtra la URL completa al salir hacia otro sitio.
  Referrer-Policy: strict-origin-when-cross-origin
  # Impide que el sitio sea incrustado en un iframe ajeno (clickjacking).
  X-Frame-Options: SAMEORIGIN
  # Desactiva permisos del navegador que el sitio no usa.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  # Obliga a usar HTTPS durante un año. Sin includeSubDomains, para no afectar
  # subdominios de correo o del sistema Avalab.
  Strict-Transport-Security: max-age=31536000

# Los archivos con hash en el nombre nunca cambian: se cachean un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Las imágenes se revisan cada semana.
/images/*
  Cache-Control: public, max-age=604800
