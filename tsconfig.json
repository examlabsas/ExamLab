{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  // `admin` tiene su propia configuración: es un Worker, con los tipos de
  // Cloudflare y sin nada de Astro. Revisarlo desde aquí daría errores falsos.
  // Se comprueba con `npm run check` dentro de esa carpeta.
  "exclude": [
    "dist",
    "design",
    "admin"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "resolveJsonModule": true,
    "allowJs": true
  }
}