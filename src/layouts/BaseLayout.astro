---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import ListaExamenes from '@/components/ListaExamenes.astro';
import SpriteIconos from '@/components/SpriteIconos.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '@/lib/site';
import { fotoOg, FOTO_POR_DEFECTO } from '@/lib/fotos';
import { medicalBusinessSchema, webSiteSchema, serializarSchema } from '@/lib/schema';
import type { SeccionWhatsApp } from '@/lib/whatsapp';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Sección que define el mensaje precargado del botón flotante. */
  whatsapp?: SeccionWhatsApp;
  /**
   * Imagen para la vista previa en WhatsApp y redes. Debe ser un JPG de
   * 1200×630 de los que genera scripts/optimizar-imagenes.mjs (`fotoOg(...)`).
   */
  imagen?: string;
  noindex?: boolean;
  /** Bloques JSON-LD adicionales de la página. */
  schema?: Record<string, unknown>[];
}

const {
  titulo,
  descripcion = site.descripcion,
  whatsapp = 'general',
  imagen = fotoOg(FOTO_POR_DEFECTO),
  noindex = false,
  schema = [],
} = Astro.props;

/*
  Título para la pestaña y para Google.

  El sufijo era `| ExamLab · Laboratorio clínico de alta complejidad en Ambato`:
  60 caracteres él solo, así que 582 de las 583 páginas pasaban del límite que
  Google muestra y el recorte se comía justo lo que hay que leer. Ahora el
  sufijo es la marca y la ciudad, y la frase larga vive donde sí se lee entera:
  en la descripción y en el H1 de la portada.

  Si aun así se pasa, se recorta el nombre de la página y no el sufijo, que es
  lo que identifica al laboratorio en una lista de resultados.
*/
const SUFIJO = ` | ${site.nombre} ${site.ciudad}`;
const MAXIMO = 60;

const tituloCompleto = titulo.includes(site.nombre)
  ? titulo
  : (() => {
      const disponible = MAXIMO - SUFIJO.length;
      const nombre =
        titulo.length <= disponible ? titulo : `${titulo.slice(0, disponible - 1).trimEnd()}…`;
      return `${nombre}${SUFIJO}`;
    })();
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const imagenAbsoluta = new URL(imagen, Astro.site ?? site.url).toString();

// Datos estructurados: la ficha MedicalBusiness va en todas las páginas.
const bloques = [medicalBusinessSchema(), webSiteSchema(), ...schema];
---

<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      El WebP de 96 px pesa 7 KB frente a los 15 del PNG de 192, y lo entienden
      todos los navegadores actuales; el PNG queda de respaldo para los viejos.
      El de 180 es el que usa iOS al guardar la página en la pantalla de
      inicio: sin él, el iPhone pone una captura borrosa en vez del logo, y
      este sitio se comparte sobre todo por WhatsApp.
    */}
    <link rel="icon" type="image/webp" href="/images/favicon-96.webp" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#005A8C" />
    <meta name="geo.region" content="EC-T" />
    <meta name="geo.placename" content={site.ciudad} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbsoluta} />

    {/* Tipografías de marca (Montserrat - web equivalent Gotham Book).
      Solo los cuatro pesos que el sitio usa: se cargaban seis más la itálica,
      y ni el 800 ni la cursiva aparecían en ninguna página. */}
    {/*
      Las tipografías se sirven desde el propio dominio (ver styles/fuentes.css).
      Se precargan los dos pesos que aparecen en la primera pantalla —el texto
      corrido y los titulares— para que no haya un salto de tipografía al
      cargar. Los otros dos llegan cuando el CSS los pide.
    */}
    <link
      rel="preload"
      href="/fuentes/montserrat-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fuentes/montserrat-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Marca que hay JS antes del primer pintado. Todas las animaciones dependen
      de la clase `js`, así que si el script falla el contenido se ve igual.

      Hay que reponerla en cada navegación: el router de Astro copia los
      atributos del <html> del documento nuevo, y ese documento llega del
      servidor sin la clase, porque la pone este script en el navegador. Sin
      reponerla, las animaciones funcionaban en la primera carga y dejaban de
      salir al moverse por el sitio hasta recargar.

      `astro:after-swap` es el momento correcto: el DOM nuevo ya está puesto,
      pero todavía no se ha pintado. */}
    <script is:inline>
      document.documentElement.classList.add('js');

      // Idempotente: si el router vuelve a ejecutar este script, no duplica el oyente.
      if (!window.__examlabClaseJs) {
        window.__examlabClaseJs = true;
        document.addEventListener('astro:after-swap', () => {
          document.documentElement.classList.add('js');
        });
      }
    </script>

    {/* Transiciones suaves entre páginas (nativo de Astro, sin dependencias) */}
    <ClientRouter />

    {/* Datos estructurados Schema.org */}
    {
      bloques.map((bloque) => (
        <script is:inline type="application/ld+json" set:html={serializarSchema(bloque)} />
      ))
    }

    <slot name="head" />
  </head>
  <body class="overflow-x-hidden">
    {/* Biblioteca de iconos: se define una vez y `Icon` la referencia con `<use>`. */}
    <SpriteIconos />
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-brand focus:px-4 focus:py-3 focus:text-sm focus:font-bold focus:text-white"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    {/* Va en el layout para que la lista siga visible al entrar en una ficha
        del catálogo y volver. */}
    <ListaExamenes />

    {/*
      Pila inferior: el botón de WhatsApp se apoya sobre el banner de cookies.

      Van juntos en una columna para que los coloque el navegador y no haya que
      medir nada. Antes cada uno era `fixed` por su cuenta y el botón se
      apartaba una distancia fija —12,5rem en móvil, 7,5 en escritorio—, que era
      una suposición: medido en el sitio publicado, el banner ocupa 101 px a
      1440 px de ancho pero 286 en un teléfono de 375, porque el mismo texto se
      reparte en muchas más líneas. El botón subía 200 y quedaba 86 px por
      debajo del borde del banner, que va por encima en el apilado y lo tapaba
      entero justo en el móvil, que es de donde llega la mayoría de pacientes.

      El contenedor cubre todo el ancho, así que no puede interceptar clics:
      `pointer-events` se apaga aquí y se reactiva en cada hijo.
    */}
    <div
      class="pointer-events-none fixed inset-x-0 bottom-0 z-50 flex flex-col items-end"
    >
      <WhatsAppFloat seccion={whatsapp} />
      <CookieBanner />
    </div>

    <script>
      // Selector único: elementos marcados a mano + todas las secciones
      // internas de cualquier página (ver global.css).
      const SELECTOR =
        '.reveal, .reveal-stagger, main > section:not(:first-of-type) > .container-page:not(.sin-reveal)';

      /**
       * `true`  → la animación se repite cada vez que el bloque vuelve a entrar
       *           en pantalla. Se nota más, útil para presentar el sitio.
       * `false` → cada bloque se anima una sola vez por carga de página. Es el
       *           comportamiento habitual en sitios de contenido: no distrae
       *           al releer y consume menos.
       */
      const REPETIR = true;

      const initReveals = () => {
        const elementos = Array.from(document.querySelectorAll<HTMLElement>(SELECTOR)).filter(
          // `astro:page-load` también corre en la carga inicial: sin este
          // filtro se crearían observadores duplicados.
          (el) => !el.dataset.observado,
        );
        if (elementos.length === 0) return;

        // Observador 1 — REVELAR.
        // Con el margen inferior negativo, avisa cuando el bloque ya entró un
        // buen tramo en pantalla, para que el movimiento ocurra a la vista.
        const observadorRevelar = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              if (!REPETIR) observadorRevelar.unobserve(entry.target);
            }
          },
          { threshold: 0, rootMargin: '0px 0px -18% 0px' },
        );

        // Observador 2 — REARMAR (solo en modo repetición).
        //
        // Hace falta uno aparte: un IntersectionObserver avisa solo cuando se
        // cruza el umbral, y no vuelve a avisar mientras siga fuera. Con el
        // margen negativo del primero, la salida se notificaba cuando el bloque
        // todavía estaba a un 82% de la pantalla — o sea, aún visible — así que
        // no se podía rearmar en ese momento sin que el contenido desapareciera
        // delante del usuario. Sin margen, "no interseca" significa
        // exactamente "quedó fuera de pantalla", que es cuándo sí se puede.
        const observadorRearmar = REPETIR
          ? new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) continue;
                  const el = entry.target as HTMLElement;

                  // El borde por el que salió determina por dónde va a volver
                  // a entrar, y por lo tanto de qué lado debe animarse: si
                  // quedó arriba de la pantalla, el usuario está subiendo y el
                  // bloque tiene que bajar hacia su sitio, no subir.
                  if (entry.boundingClientRect.bottom <= 0) {
                    el.style.setProperty('--reveal-signo', '-1');
                  } else {
                    el.style.setProperty('--reveal-signo', '1');
                  }

                  el.classList.remove('is-visible');
                }
              },
              /*
                Margen positivo: el área de observación se agranda 200px por
                lado, así que "no interseca" significa "quedó bien lejos de la
                pantalla", no "apenas salió".

                Sin ese margen los dos observadores se peleaban: al revelarse,
                el bloque se desplaza 64px hacia su sitio; ese movimiento podía
                sacarlo del área del segundo observador, que le quitaba la
                clase, lo que lo devolvía 64px atrás y volvía a activar al
                primero. Eso era el temblor: dos observadores empujando el
                mismo bloque decenas de veces por segundo.

                200px > los 64px que recorre el bloque, así que ya no puede
                oscilar entre ambas zonas.
              */
              { threshold: 0, rootMargin: '200px' },
            )
          : null;

        for (const el of elementos) {
          el.dataset.observado = 'true';
          observadorRevelar.observe(el);
          observadorRearmar?.observe(el);

          // Seguro por si el observador tardara en emitir su primer aviso:
          // lo que ya está en pantalla se revela de una vez.
          const caja = el.getBoundingClientRect();
          if (caja.top < window.innerHeight && caja.bottom > 0) {
            el.classList.add('is-visible');
          }
        }
      };

      // Red de seguridad: si algo falla en el revelado, se quita la clase `js`
      // y todo el contenido queda visible. Nunca debe perderse contenido por
      // culpa de una animación.
      const revelarConSeguridad = () => {
        try {
          initReveals();
        } catch (error) {
          document.documentElement.classList.remove('js');
          console.error('[reveal] desactivado por error:', error);
        }
      };

      revelarConSeguridad();
      document.addEventListener('astro:page-load', revelarConSeguridad);

      /*
        Pausa las animaciones de fondo que quedan fuera de pantalla.

        Las gotas y el pulso del electro son bucles infinitos: en `/servicios`
        hay dieciséis a la vez y seguían corriendo con su sección a tres
        pantallas de distancia. El observador se crea una sola vez y se le van
        añadiendo los bloques nuevos de cada página; no se desconecta porque
        vive lo mismo que la pestaña.
      */
      const observadorFondos = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            (entry.target as HTMLElement).dataset.fuera = String(!entry.isIntersecting);
          }
        },
        { threshold: 0, rootMargin: '100px' },
      );

      const observarFondos = () => {
        for (const el of document.querySelectorAll<HTMLElement>('[data-anim-fondo]')) {
          if (el.dataset.observadoFondo === 'true') continue;
          el.dataset.observadoFondo = 'true';

          // Estado de partida, sin esperar al primer aviso del observador: en
          // una página larga la mayoría nace fuera de pantalla y no tiene
          // sentido dejarla animándose hasta que el observador despierte.
          const caja = el.getBoundingClientRect();
          el.dataset.fuera = String(caja.bottom < -100 || caja.top > window.innerHeight + 100);

          observadorFondos.observe(el);
        }
      };

      observarFondos();
      document.addEventListener('astro:page-load', observarFondos);
    </script>
  </body>
</html>
