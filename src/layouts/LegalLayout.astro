---
import BaseLayout from './BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { footerLegales } from '@/lib/site';
import { formatoFechaLarga } from '@/lib/fechas';
import { breadcrumbSchema } from '@/lib/schema';

interface Props {
  titulo: string;
  descripcion: string;
  actualizado: string;
  ruta: string;
}

const { titulo, descripcion, actualizado, ruta } = Astro.props;
const fecha = new Date(actualizado);
---

<BaseLayout
  titulo={titulo}
  descripcion={descripcion}
  whatsapp="privacidad"
  schema={[
    breadcrumbSchema([
      { nombre: 'Inicio', href: '/' },
      { nombre: titulo, href: ruta },
    ]),
  ]}
>
  <section class="bg-brand">
    <div class="container-page py-10 lg:py-14">
      <nav aria-label="Ruta de navegación" class="mb-6">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/75">
          <li><a href="/" class="transition-colors hover:text-accent-light">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/85" aria-current="page">{titulo}</li>
        </ol>
      </nav>
      <h1 class="max-w-[760px] text-h1 font-bold text-white">{titulo}</h1>
      <p class="mt-5 flex items-center gap-2.5 text-sm text-white/75">
        <Icon name="reloj" size={16} class="text-accent-light" />
        Última actualización: {formatoFechaLarga(fecha)}
      </p>
    </div>
  </section>

  <section class="bg-white py-12 lg:py-16">
    <div class="container-page grid grid-cols-1 gap-10 lg:grid-cols-[1fr_260px] lg:gap-14">
      <div class="prose-examlab max-w-[760px]">
        <slot />
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-xl bg-surface p-6">
          <span class="block text-xs font-bold tracking-[1.2px] text-neutral uppercase">
            Documentos legales
          </span>
          <div class="mt-4 flex flex-col gap-3">
            {
              footerLegales.map((enlace) => (
                <a
                  href={enlace.href}
                  aria-current={enlace.href === ruta ? 'page' : undefined}
                  class:list={[
                    'text-sm transition-colors hover:text-accent-dark',
                    enlace.href === ruta ? 'font-bold text-brand' : 'font-medium text-neutral',
                  ]}
                >
                  {enlace.label}
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
