---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CatalogoBuscador from '@/components/CatalogoBuscador.astro';
import { examenes } from '@/lib/examenes';
import { breadcrumbSchema } from '@/lib/schema';
import { whatsappLink } from '@/lib/whatsapp';
import { site } from '@/lib/site';

const schema = [
  breadcrumbSchema([
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Catálogo de exámenes', href: '/catalogo' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Catálogo de exámenes de ExamLab',
    numberOfItems: examenes.length,
    itemListElement: examenes.map((examen, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: examen.nombre,
      url: new URL(`/catalogo/${examen.slug}`, site.url).toString(),
    })),
  },
];
---

<BaseLayout
  titulo="Catálogo de exámenes"
  descripcion="Busque cualquier examen por código, nombre o especialidad y consulte tipo de muestra, tiempo de entrega y condiciones del estudio y del paciente."
  whatsapp="catalogo"
  schema={schema}
>
  {/*
    Cabecera compacta: esta página es una herramienta, no un texto. Con el
    titular a tamaño completo el buscador quedaba fuera de la primera pantalla,
    justo lo que la gente viene a usar.
  */}
  <PageHero
    compacto
    titulo={`Catálogo de ${examenes.length} exámenes`}
    descripcion="Busque por nombre, especialidad o cómo lo llama la gente."
    migas={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Catálogo de exámenes', href: '/catalogo' },
    ]}
  />

  <CatalogoBuscador
    lista={examenes}
    basePath="/catalogo"
    whatsappHref={whatsappLink('catalogo')}
    aviso="Las indicaciones de cada examen son las que usamos habitualmente en el laboratorio. Si su médico le dio otras, siga las de su médico. Y si quiere saber el valor de un examen o si aplica su convenio, escríbanos por WhatsApp antes de venir: con gusto le ayudamos."
  />
</BaseLayout>
