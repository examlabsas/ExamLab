---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CatalogoAsociados from '@/components/CatalogoAsociados.astro';
import catalogo from '@/data/catalogo-asociados.json';
import { breadcrumbSchema } from '@/lib/schema';

/*
  El tarifario de convenio es información comercial reservada. Mientras esta
  página siga siendo de acceso abierto queda en `false`, y así el precio no se
  renderiza: no viaja al navegador ni aparece en el código fuente.

  Se pone en `true` únicamente cuando la ruta esté detrás de control de acceso,
  como lo estaba en el sitio anterior con los usuarios de WordPress.
*/
const MOSTRAR_PRECIOS = false;

const schema = [
  breadcrumbSchema([
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Laboratorios asociados', href: '/laboratorios-asociados' },
    { nombre: 'Catálogo laboratorios', href: '/laboratorios-asociados/catalogo' },
  ]),
];
---

<BaseLayout
  titulo="Catálogo laboratorios"
  descripcion="Cartera de pruebas de derivación para laboratorios asociados de ExamLab, con método, tipo de muestra y tiempo de entrega."
  whatsapp="laboratorios"
  noindex
  schema={schema}
>
  <PageHero
    eyebrow="Laboratorios asociados"
    titulo="Catálogo de derivación"
    descripcion={`${catalogo.pruebas.length} pruebas con su método, tipo de muestra y tiempo de entrega. Busque por nombre, método o muestra.`}
    migas={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Laboratorios asociados', href: '/laboratorios-asociados' },
      { nombre: 'Catálogo laboratorios', href: '/laboratorios-asociados/catalogo' },
    ]}
  />

  <CatalogoAsociados mostrarPrecios={MOSTRAR_PRECIOS} />
</BaseLayout>
