---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CatalogoBuscador from '@/components/CatalogoBuscador.astro';
import { examenesLaboratorios } from '@/lib/examenes';
import { breadcrumbSchema } from '@/lib/schema';
import { whatsappLink } from '@/lib/whatsapp';

const schema = [
  breadcrumbSchema([
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Laboratorios asociados', href: '/laboratorios-asociados' },
    { nombre: 'Catálogo laboratorios', href: '/laboratorios-asociados/catalogo' },
  ]),
];
---

<BaseLayout
  titulo="Catálogo laboratorios"
  descripcion="Cartera de pruebas de derivación para laboratorios asociados de ExamLab, con especialidad, tipo de muestra, contenedor y tiempo de entrega."
  whatsapp="laboratorios"
  noindex
  schema={schema}
>
  <PageHero
    eyebrow="Laboratorios asociados"
    titulo="Catálogo para laboratorios"
    descripcion="Cartera de pruebas de derivación con sus condiciones preanalíticas. Busque por código, nombre o especialidad."
    migas={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Laboratorios asociados', href: '/laboratorios-asociados' },
      { nombre: 'Catálogo laboratorios', href: '/laboratorios-asociados/catalogo' },
    ]}
  />

  <CatalogoBuscador
    lista={examenesLaboratorios}
    basePath="/laboratorios-asociados/catalogo"
    tecnico
    whatsappHref={whatsappLink('laboratorios')}
    aviso="Este catálogo es de uso exclusivo de laboratorios asociados y sus condiciones aplican a muestras derivadas. Los tiempos de entrega se cuentan desde la recepción de la muestra en nuestra matriz. Para tarifario mayorista y logística de recolección, escríbanos por WhatsApp."
  />
</BaseLayout>
