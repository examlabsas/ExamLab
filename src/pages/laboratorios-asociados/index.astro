---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BuscadorExamenes from '@/components/BuscadorExamenes.astro';
import { site } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';
import { breadcrumbSchema } from '@/lib/schema';
import type { IconName } from '@/lib/iconos';

const schema = [
  breadcrumbSchema([
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Laboratorios asociados', href: '/laboratorios-asociados' },
  ]),
];

type Acceso = {
  id: string;
  icono: IconName;
  titulo: string;
  descripcion: string;
  cta: string;
  href: string;
  /** Depende de Avalab, que todavía no está implementado. */
  pendiente?: boolean;
};

const accesos: Acceso[] = [
  {
    id: 'ingresar-orden',
    icono: 'documento',
    titulo: 'Ingresar orden',
    descripcion:
      'Registre las órdenes de sus pacientes directamente en el sistema, con los datos de la muestra y las pruebas solicitadas.',
    cta: 'Ingresar orden',
    href: site.avalabOrden,
    pendiente: !site.avalabDisponible,
  },
  {
    id: 'catalogo-laboratorios',
    icono: 'lupa',
    titulo: 'Catálogo laboratorios',
    descripcion:
      'Cartera de pruebas disponible para laboratorios asociados, con especialidad, tipo de muestra, contenedor y tiempo de entrega.',
    cta: 'Abrir catálogo',
    href: '/laboratorios-asociados/catalogo',
  },
  {
    id: 'resultados',
    icono: 'monitor',
    titulo: 'Resultados',
    descripcion:
      'Consulte y descargue los informes validados de las órdenes que su laboratorio nos derivó.',
    cta: 'Ver resultados',
    href: site.avalabResultados,
    pendiente: !site.avalabDisponible,
  },
];

const beneficios: { icono: IconName; titulo: string; texto: string }[] = [
  {
    icono: 'camion',
    titulo: 'Recolección de muestras',
    texto:
      'Coordinamos el retiro en su laboratorio con cadena de frío controlada y trazabilidad por código de barras.',
  },
  {
    icono: 'escudo',
    titulo: 'Pruebas de derivación',
    texto:
      'Procesamos las pruebas especializadas que su laboratorio no realiza, manteniendo su relación con el paciente.',
  },
  {
    icono: 'maletin',
    titulo: 'Tarifario mayorista',
    texto:
      'Valores diferenciados por volumen, con facturación mensual consolidada y estado de cuenta detallado.',
  },
  {
    icono: 'usuarios',
    titulo: 'Soporte técnico',
    texto:
      'Nuestro equipo de bioquímicos resuelve consultas sobre condiciones preanalíticas e interpretación.',
  },
];
---

<BaseLayout
  titulo="Laboratorios asociados"
  descripcion="Portal para laboratorios asociados de ExamLab: ingreso de órdenes, catálogo de pruebas de derivación y consulta de resultados."
  whatsapp="laboratorios"
  schema={schema}
>
  <PageHero
    eyebrow="Laboratorios asociados"
    titulo="Su laboratorio, respaldado por el nuestro"
    descripcion="Derive las pruebas que no procesa y manténgase como el laboratorio de confianza de su paciente. Ingreso de órdenes, catálogo y resultados en un solo lugar."
    migas={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Laboratorios asociados', href: '/laboratorios-asociados' },
    ]}
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button href="/laboratorios-asociados/catalogo" icon="lupa">Catálogo laboratorios</Button>
      <Button href={whatsappLink('laboratorios')} variant="sobreOscuro" icon="whatsapp-marca">
        Quiero asociarme
      </Button>
    </div>

    <!-- Apunta al catálogo de laboratorios, no al público. -->
    <BuscadorExamenes
      id="buscar-laboratorios"
      accion="/laboratorios-asociados/catalogo"
      oscuro
      class="mt-5"
      placeholder="Busque una prueba de derivación: código o nombre…"
    />
  </PageHero>

  <!-- Accesos -->
  <section class="bg-white py-section">
    <div class="container-page">
      <SectionHeading eyebrow="Accesos" titulo="Qué puede hacer desde aquí" />

      <div class="mt-9 grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          accesos.map((acceso) => (
            <article
              id={acceso.id}
              class="flex scroll-mt-28 flex-col gap-4 rounded-2xl border border-line bg-white p-7 transition-all duration-200 hover:border-brand hover:shadow-md"
            >
              <div class="flex items-start justify-between gap-3">
                <span class="text-brand">
                  <Icon name={acceso.icono} size={26} strokeWidth={2} />
                </span>
                {acceso.pendiente && (
                  <span class="rounded-lg bg-alert-soft px-2.5 py-1 text-[10.5px] font-bold tracking-[0.4px] text-alert-dark uppercase">
                    En implementación
                  </span>
                )}
              </div>

              <h2 class="text-[19px] font-bold text-brand">{acceso.titulo}</h2>
              <p class="text-[14px] leading-relaxed text-neutral">{acceso.descripcion}</p>

              <div class="mt-auto pt-3">
                {acceso.pendiente ? (
                  <>
                    <span class="flex w-full items-center justify-center gap-2 rounded-xl border border-dashed border-line-strong px-4 py-3 text-[13px] font-semibold text-neutral">
                      <Icon name="reloj" size={16} />
                      Disponible próximamente
                    </span>
                    <p class="mt-2.5 text-[12.5px] leading-relaxed text-neutral">
                      Este acceso funcionará con Avalab, el sistema del laboratorio. Le avisaremos
                      apenas esté habilitado.
                    </p>
                  </>
                ) : (
                  <Button href={acceso.href} size="sm" full>
                    {acceso.cta}
                  </Button>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="bg-surface py-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="El convenio"
        titulo="Qué incluye ser laboratorio asociado"
        descripcion="Un acuerdo pensado para laboratorios pequeños y medianos que necesitan respaldo en pruebas especializadas."
      />
      <div class="mt-9 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          beneficios.map((item) => (
            <article class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-6">
              <span class="text-brand">
                <Icon name={item.icono} size={24} strokeWidth={2} />
              </span>
              <h3 class="text-[16px] font-bold text-brand">{item.titulo}</h3>
              <p class="text-[13.5px] leading-relaxed text-neutral">{item.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section class="bg-white py-section">
    <div class="container-page">
      <div
        class="grid grid-cols-1 gap-8 rounded-2xl bg-brand p-8 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12 lg:p-12"
      >
        <div>
          <span class="text-[12.5px] font-bold tracking-[1.8px] text-accent-light uppercase">
            Sumarse a la red
          </span>
          <h2 class="mt-3 max-w-[560px] text-h2 font-bold text-white">
            Conversemos sobre el convenio para su laboratorio
          </h2>
          <p class="mt-4 max-w-[560px] text-[15px] leading-relaxed text-white/75">
            Cuéntenos qué pruebas necesita derivar y con qué frecuencia, y le preparamos una
            propuesta con tarifario y logística de recolección.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <Button href={whatsappLink('laboratorios')} icon="whatsapp-marca">
            Escribir por WhatsApp
          </Button>
          <Button href={`mailto:${site.email}`} variant="sobreOscuro" icon="correo">
            {site.email}
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
