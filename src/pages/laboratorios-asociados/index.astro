---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BuscadorExamenes from '@/components/BuscadorExamenes.astro';
import FondoGotas from '@/components/FondoGotas.astro';
import PulsoEcg from '@/components/PulsoEcg.astro';
import { site } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';
import { breadcrumbSchema } from '@/lib/schema';
import type { IconName } from '@/lib/iconos';

const schema = [
  breadcrumbSchema([
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Laboratorios asociados', href: '/laboratorios-asociados' },
  ]),
];

type Acceso = {
  id: string;
  icono: IconName;
  titulo: string;
  descripcion: string;
  cta: string;
  href: string;
};

const accesos: Acceso[] = [
  {
    id: 'ingresar-orden',
    icono: 'documento',
    titulo: 'Ingresar orden',
    descripcion:
      'Registre las órdenes de sus pacientes directamente en el sistema, con los datos de la muestra y las pruebas solicitadas.',
    cta: 'Ingresar orden',
    href: site.sistema.url,
  },
  {
    id: 'catalogo-laboratorios',
    icono: 'lupa',
    titulo: 'Catálogo laboratorios',
    descripcion:
      'Cartera de pruebas disponible para laboratorios asociados, con especialidad, tipo de muestra, contenedor y tiempo de entrega.',
    cta: 'Abrir catálogo',
    href: '/laboratorios-asociados/catalogo',
  },
  {
    id: 'resultados',
    icono: 'monitor',
    titulo: 'Resultados',
    descripcion:
      'Consulte y descargue los informes validados de las órdenes que su laboratorio nos derivó.',
    cta: 'Ver resultados',
    href: site.sistema.url,
  },
];

const beneficios: { icono: IconName; titulo: string; texto: string }[] = [
  {
    icono: 'camion',
    titulo: 'Recolección de muestras',
    texto:
      'Coordinamos el retiro en su laboratorio con cadena de frío controlada y trazabilidad por código de barras.',
  },
  {
    icono: 'escudo',
    titulo: 'Pruebas de derivación',
    texto:
      'Procesamos las pruebas especializadas que su laboratorio no realiza, manteniendo su relación con el paciente.',
  },
  {
    icono: 'maletin',
    titulo: 'Tarifario mayorista',
    texto:
      'Valores diferenciados por volumen, con facturación mensual consolidada y estado de cuenta detallado.',
  },
  {
    icono: 'usuarios',
    titulo: 'Soporte técnico',
    texto:
      'Nuestro equipo de bioquímicos resuelve consultas sobre condiciones preanalíticas e interpretación.',
  },
];
---

<BaseLayout
  titulo="Laboratorios asociados"
  descripcion="Portal para laboratorios asociados de ExamLab: ingreso de órdenes, catálogo de pruebas de derivación y consulta de resultados."
  whatsapp="laboratorios"
  schema={schema}
>
  <PageHero
    foto="tecnologa-en-analizador"
    eyebrow="Laboratorios asociados"
    titulo="Derivación de pruebas para laboratorios"
    descripcion="Derive las pruebas que no procesa y manténgase como el laboratorio de confianza de su paciente. Ingreso de órdenes, catálogo y resultados en un solo lugar."
    migas={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Laboratorios asociados', href: '/laboratorios-asociados' },
    ]}
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button href="/laboratorios-asociados/catalogo" icon="lupa">Catálogo laboratorios</Button>
      <Button href={whatsappLink('laboratorios')} variant="sobreOscuro" icon="whatsapp-marca">
        Quiero asociarme
      </Button>
    </div>

    {/* Apunta al catálogo de laboratorios, no al público. */}
    <BuscadorExamenes
      id="buscar-laboratorios"
      accion="/laboratorios-asociados/catalogo"
      oscuro
      class="mt-5"
      placeholder="Busque una prueba de derivación: código o nombre…"
    />
  </PageHero>

  {/* Accesos */}
  <section class="bg-white py-section">
    <div class="container-page">
      <SectionHeading eyebrow="Accesos" titulo="Qué puede hacer desde aquí" />

      <div class="reveal-stagger mt-9 grid grid-cols-1 gap-x-9 gap-y-10 md:grid-cols-3">
        {
          accesos.map((acceso) => (
            <article
              id={acceso.id}
              class="flex scroll-mt-28 flex-col gap-3 border-t-2 border-line pt-5"
            >
              <Icon name={acceso.icono} size={23} strokeWidth={2} dibujo class="text-accent-dark" />

              <h2 class="mt-1 text-lg leading-snug font-bold text-brand">{acceso.titulo}</h2>
              <p class="text-sm leading-relaxed text-neutral">{acceso.descripcion}</p>

              <div class="mt-auto pt-3">
                <Button href={acceso.href} size="sm" full>
                  {acceso.cta}
                </Button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Beneficios */}
  <section class="bg-surface py-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="El convenio"
        titulo="Qué incluye ser laboratorio asociado"
        descripcion="Un acuerdo pensado para laboratorios pequeños y medianos que necesitan respaldo en pruebas especializadas."
      />
      <div class="reveal-stagger mt-9 grid grid-cols-1 gap-x-9 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          beneficios.map((item) => (
            /* Afirmaciones, no destinos: sin filete. Además va sobre gris, donde
               el filete obligaba a oscurecer la línea para que se viera. */
            <article>
              <Icon name={item.icono} size={23} strokeWidth={2} dibujo class="text-accent-dark" />
              <h3 class="mt-4 text-lg leading-snug font-bold text-brand">{item.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral">{item.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Contacto */}
  <section class="bg-white py-section">
    <div class="container-page">
      <div
        class="relative grid grid-cols-1 gap-8 overflow-hidden rounded-xl bg-brand p-8 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12 lg:p-12"
      >
        <FondoGotas />
        <PulsoEcg class="text-white opacity-25" />
        <div class="relative">
          <span class="text-xs font-bold tracking-[1.8px] text-accent-light uppercase">
            Sumarse a la red
          </span>
          <h2 class="mt-3 max-w-[560px] text-h2 font-bold text-white">
            Conversemos sobre el convenio para su laboratorio
          </h2>
          <p class="mt-4 max-w-[560px] text-base leading-relaxed text-white/75">
            Cuéntenos qué pruebas necesita derivar y con qué frecuencia, y le preparamos una
            propuesta con tarifario y logística de recolección.
          </p>
        </div>
        <div class="relative flex flex-col gap-3">
          <Button href={whatsappLink('laboratorios')} icon="whatsapp-marca">
            Escribir por WhatsApp
          </Button>
          <Button href={`mailto:${site.emails.laboratorio}`} variant="sobreOscuro" icon="correo">
            {site.emails.laboratorio}
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
