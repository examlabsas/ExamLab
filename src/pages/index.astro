---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import SedesMapa from '@/components/SedesMapa.astro';
import NewsCard from '@/components/NewsCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaDomicilio from '@/components/CtaDomicilio.astro';
import Cifras, { type Cifra } from '@/components/Cifras.astro';
import BuscadorExamenes from '@/components/BuscadorExamenes.astro';
import FondoGotas from '@/components/FondoGotas.astro';
import FranjaInstagram from '@/components/FranjaInstagram.astro';
import PulsoEcg from '@/components/PulsoEcg.astro';
import { site, sedes } from '@/lib/site';
import { foto, fotoOg, SIZES_MEDIA_COLUMNA, type NombreFoto } from '@/lib/fotos';
import { whatsappLink } from '@/lib/whatsapp';
import { getCollection } from 'astro:content';
import especialidadesData from '@/data/especialidades.json';
import perfiles from '@/data/perfiles.json';
import type { IconName } from '@/lib/iconos';

const noticias = (await getCollection('noticias', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const especialidades = especialidadesData.filter((e) => e.enPortada);

/*
  Las cifras salen de los datos reales del sitio donde se puede: el número de
  especialidades viene de especialidades.json y el de sedes de site.ts. Así no
  quedan desactualizadas cuando esos datos cambien.
*/
const cifras: Cifra[] = [
  { valor: 400, sufijo: '+', etiqueta: 'Análisis clínicos disponibles' },
  { valor: especialidadesData.length, etiqueta: 'Especialidades de laboratorio' },
  { valor: sedes.length, etiqueta: `Sedes en ${sedes[0]!.provincia}` },
  { valor: 24, sufijo: ' h', etiqueta: 'Entrega en exámenes de rutina' },
];

/*
  Cada punto nombra algo verificable. Los títulos genéricos —«resultados
  confiables», «tecnología moderna»— servían igual para cualquier negocio.
*/
/* Galería de la portada: foto, a qué página lleva y un pie de dos líneas. */
const galeria: { foto: NombreFoto; href: string; titulo: string; texto: string }[] = [
  {
    foto: 'microscopio',
    href: '/catalogo',
    titulo: 'Microscopía',
    texto: 'Orina, heces y frotis, uno por uno',
  },
  {
    foto: 'analizador-automatizado',
    href: '/servicios',
    titulo: 'Analizadores automatizados',
    texto: 'Química, hematología e inmunología',
  },
  {
    foto: 'recepcion-de-muestras',
    href: '/soy-paciente/pedir-cita',
    titulo: 'Recepción de muestras',
    texto: 'Cada tubo con su código de barras',
  },
  {
    foto: 'matriz-ficoa-fachada',
    href: '/sedes/ambato-matriz',
    titulo: 'Matriz Ficoa',
    texto: 'Av. Rodrigo Pachano y Reina Claudia',
  },
];

const ventajas = [
  {
    icono: 'check' as const,
    titulo: 'Doble validación',
    texto: 'El analista revisa el resultado y el responsable técnico lo aprueba antes de emitirlo.',
  },
  {
    icono: 'reloj' as const,
    titulo: 'Entrega el mismo día',
    texto: 'Los exámenes de rutina se publican en línea el mismo día de la toma de muestra.',
  },
  {
    icono: 'usuario' as const,
    titulo: 'Bioquímicos y tecnólogos',
    texto: 'Personal titulado en laboratorio clínico, con formación continua.',
  },
  {
    icono: 'monitor' as const,
    titulo: 'Trazabilidad por muestra',
    texto: 'Cada muestra se sigue por código de barras desde la recepción hasta el informe.',
  },
];
---

<BaseLayout
  titulo={`${site.nombre} · Laboratorio clínico de alta complejidad en ${site.ciudad}`}
  descripcion={site.descripcion}
  whatsapp="home"
  imagen={fotoOg('matriz-ficoa-fachada')}
>
  {/* ── Hero ─────────────────────────────────────────────────────── */}
  {/*
    El fondo no es blanco plano: un degradado de blanco a celeste que se
    acentúa hacia la foto, un halo detrás de ella, y encima las mismas gotas y
    el pulso de las secciones azules, aquí en azul de marca. Menos aire arriba:
    la cabecera fija ya separa del borde.
  */}
  <section class="hero-portada relative overflow-hidden pt-6 pb-10 lg:pt-10 lg:pb-14 border-b border-line">
    <FondoGotas tono="claro" />
    <PulsoEcg class="h-24 text-brand opacity-[0.14]" />
    <span class="hero-halo pointer-events-none absolute" aria-hidden="true"></span>
    <div class="container-page relative grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <div class="entrada entrada-1 inline-flex items-center gap-2 rounded-md bg-brand-soft/60 px-3.5 py-1.5 border border-brand/10">
          <span class="text-xs font-bold tracking-wider text-brand uppercase">
            Nueva imagen, la misma trayectoria
          </span>
        </div>

        <h1 class="entrada entrada-2 mt-4 text-h1 font-bold tracking-tight text-brand">
          Laboratorio clínico de alta complejidad
        </h1>

        <p class="entrada entrada-3 mt-4 max-w-[540px] text-lead text-neutral leading-relaxed">
          Uno de los dos laboratorios de la región con este nivel de complejidad. Análisis de
          rutina y pruebas especializadas en Ambato y Pelileo, con toma de muestra en sede o a
          domicilio y resultados en línea.
        </p>

        <div class="entrada entrada-4 mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href={whatsappLink('cita')} icon="whatsapp-marca">Agendar cita por WhatsApp</Button>
          <Button href="/soy-paciente/resultados" variant="secondary" icon="documento">
            Ver mis resultados
          </Button>
        </div>

        <BuscadorExamenes
          id="buscar-hero"
          class="entrada entrada-4 mt-4"
          ejemplos={['glucosa', 'biometría hemática', 'TSH', 'urocultivo', 'perfil lipídico', 'hemoglobina glicosilada']}
        />

        <div class="entrada entrada-5 mt-8 pt-6 border-t border-line grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="flex items-center gap-2.5 text-xs font-semibold text-neutral">
            <Icon name="check" size={16} strokeWidth={2.4} class="text-accent-dark shrink-0" />
            <span>Resultados en línea 24/7</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs font-semibold text-neutral">
            <Icon name="casa" size={16} strokeWidth={2} class="text-accent-dark shrink-0" />
            <span>Muestras a domicilio</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs font-semibold text-neutral">
            <Icon name="reloj" size={16} strokeWidth={2} class="text-accent-dark shrink-0" />
            <span>Entrega el mismo día</span>
          </div>
        </div>
      </div>

      {/* El contenedor recorta el acercamiento lento de la foto (`.foto-viva`). */}
      <div class="entrada-imagen relative overflow-hidden rounded-xl border border-line">
        <img
          {...foto('matriz-ficoa-fachada')}
          sizes={SIZES_MEDIA_COLUMNA}
          fetchpriority="high"
          decoding="async"
          class="foto-viva h-[clamp(18.75rem,36vw,28.75rem)] w-full object-cover"
        />
      </div>
    </div>
  </section>

  {/* ── Accesos rápidos ──────────────────────────────────────────── */}
  <section id="accesos" class="scroll-mt-24 bg-white py-12 lg:py-16">
    <div class="container-page grid grid-cols-1 gap-x-9 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 reveal-stagger">
      <ServiceCard
        icono="documento"
        titulo="Resultados en línea"
        descripcion="Consulte y descargue sus informes con su cédula y código de orden."
        cta="Ingresar"
        href="/soy-paciente/resultados"
      />
      <ServiceCard
        icono="calendario"
        titulo="Pedir cita"
        descripcion="Reserve su turno por WhatsApp y evite tiempos de espera."
        cta="Agendar"
        href="/soy-paciente/pedir-cita"
      />
      <ServiceCard
        icono="lupa"
        titulo="Catálogo de exámenes"
        descripcion="Especialidad, muestra, tiempo de entrega y condiciones de cada análisis."
        cta="Buscar"
        href="/catalogo"
      />
      <ServiceCard
        icono="pin"
        titulo="Nuestras sedes"
        descripcion="Puntos de atención en Ambato y Pelileo con horarios extendidos."
        cta="Ver mapa"
        href="/sedes"
      />
    </div>
  </section>

  {/* ── Especialidades ───────────────────────────────────────────── */}
  <section id="catalogo" class="scroll-mt-24 bg-surface py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Especialidades"
        titulo="Más de 400 análisis clínicos en un solo lugar"
        ctaLabel="Ver catálogo completo"
        ctaHref="/catalogo"
      />
      <div class="mt-9 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 reveal-stagger">
        {
          especialidades.map((especialidad) => (
            <CategoryCard
              icono={especialidad.icono as IconName}
              titulo={especialidad.nombre}
              descripcion={especialidad.descripcion}
              conteo={especialidad.conteo}
              href={`/catalogo?especialidad=${encodeURIComponent(especialidad.nombre)}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Perfiles temáticos ───────────────────────────────────────── */}
  <section id="perfiles" class="scroll-mt-24 bg-white py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Perfiles y chequeos"
        titulo="Paquetes de análisis para su control médico"
        descripcion="Exámenes agrupados para agilizar su diagnóstico con una sola toma de muestra."
      />
      <div class="mt-9 grid grid-cols-1 gap-x-9 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 reveal-stagger">
        {
          perfiles.map((perfil) => (
            <a
              href={whatsappLink('chequeos')}
              target="_blank"
              rel="noopener"
              class="group relative flex flex-col pt-5"
            >
              <span class="absolute inset-x-0 top-0 h-0.5 bg-line" aria-hidden="true" />
              <span
                class="absolute top-0 left-0 h-0.5 w-0 bg-accent-dark transition-[width] duration-300 ease-out group-hover:w-full group-focus-visible:w-full motion-reduce:transition-none"
                aria-hidden="true"
              />
              <div class="flex items-center justify-between gap-3">
                <Icon
                  name={perfil.icono as IconName}
                  size={23}
                  strokeWidth={2}
                  class="text-accent-dark"
                />
                <span class="text-[11px] font-bold tracking-wide text-neutral uppercase">
                  {perfil.publico}
                </span>
              </div>
              <span class="mt-4 block text-lg leading-snug font-bold text-brand transition-colors duration-200 group-hover:text-accent-dark">
                {perfil.nombre}
              </span>
              <span class="mt-2 block text-sm leading-relaxed text-neutral">
                {perfil.descripcion}
              </span>
              <span class="mt-5 flex items-center gap-1.5 text-[11px] font-bold tracking-wide text-accent-dark uppercase">
                <Icon name="whatsapp-marca" size={14} class="text-whatsapp" />
                Consultar por WhatsApp
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Domicilio y emergencias ──────────────────────────────────── */}
  <div class="reveal">
    <CtaDomicilio />
  </div>

  {/* ── Cifras ───────────────────────────────────────────────────── */}
  <section class="border-b border-line bg-white py-section-sm">
    <div class="container-page reveal">
      <Cifras cifras={cifras} />
    </div>
  </section>

  {/* ── Por qué elegirnos ────────────────────────────────────────── */}
  <section class="bg-white py-section">
    <div class="container-page grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-14 reveal">
      {/* Misma altura que el texto de la derecha en escritorio (ver Soy profesional). */}
      <div class="relative overflow-hidden rounded-xl border border-line lg:self-stretch">
        <img
          {...foto('laboratorio-equipo-trabajando')}
          sizes={SIZES_MEDIA_COLUMNA}
          loading="lazy"
          decoding="async"
          class="h-[clamp(18.75rem,38vw,28.75rem)] w-full object-cover lg:absolute lg:inset-0 lg:h-full"
        />
      </div>

      <div>
        <span class="inline-flex items-center gap-2 rounded-md bg-brand-soft/60 px-3 py-1 text-xs font-semibold text-brand border border-brand/10">
          Control de calidad
        </span>
        <h2 class="mt-3 text-h2 font-bold text-brand">Cómo cuidamos la exactitud del resultado</h2>
        <p class="mt-3 text-sm text-neutral leading-relaxed">
          Cada prueba pasa por controles internos y externos antes de que se emita el informe.
        </p>

        <div class="mt-7 grid grid-cols-1 gap-6 sm:grid-cols-2 reveal-stagger">
          {
            ventajas.map((ventaja) => (
              <div class="flex items-start gap-3.5">
                <span class="mt-0.5 flex shrink-0 items-center justify-center text-brand">
                  <Icon name={ventaja.icono} size={22} strokeWidth={2} dibujo />
                </span>
                <div>
                  <h3 class="text-sm font-bold text-brand">{ventaja.titulo}</h3>
                  <p class="mt-1 text-xs leading-relaxed text-neutral">{ventaja.texto}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ── Galería ──────────────────────────────────────────────────── */}
  <section class="bg-surface py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Así trabajamos"
        titulo="Conozca el laboratorio por dentro"
        descripcion="Fotos reales de nuestro equipo y nuestras áreas de análisis en la matriz de Ficoa."
      />
      {/*
        Cuatro fotos con el mismo encuadre 4:3. Al pasar el cursor la foto
        hace un zoom suave y el pie se realza; cada una lleva a la página que
        cuenta esa parte del trabajo.
      */}
      <div class="mt-9 grid grid-cols-2 gap-4 lg:grid-cols-4 reveal-stagger">
        {
          galeria.map((item) => (
            <a
              href={item.href}
              class="group relative block overflow-hidden rounded-xl bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-dark"
            >
              <img
                {...foto(item.foto)}
                sizes="(min-width: 64rem) 25vw, 50vw"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              />
              <span
                class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-dark/85 to-transparent px-4 pt-10 pb-3.5 text-sm font-bold text-white transition-colors duration-300 group-hover:from-brand-dark/95"
              >
                {item.titulo}
                <span class="mt-0.5 block text-xs font-medium text-white/75">{item.texto}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Sedes ────────────────────────────────────────────────────── */}
  <SedesMapa />

  {/* ── Noticias ─────────────────────────────────────────────────── */}
  <section id="noticias" class="scroll-mt-24 bg-surface py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Noticias y salud"
        titulo="Información y prevención médica"
        ctaLabel="Ver todas las noticias"
        ctaHref="/noticias"
      />
      <div class="mt-9 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 reveal-stagger">
        {
          noticias.map((nota) => (
            <NewsCard
              slug={nota.id}
              titulo={nota.data.titulo}
              descripcion={nota.data.descripcion}
              categoria={nota.data.categoria}
              fecha={nota.data.fecha}
              foto={nota.data.foto}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Instagram ────────────────────────────────────────────────── */}
  <FranjaInstagram />
</BaseLayout>

<style>
  /* Celeste de marca en la esquina superior izquierda, que se aclara hasta el blanco abajo a la derecha. */
  .hero-portada {
    background:
      linear-gradient(135deg, var(--color-accent-soft) 0%, var(--color-surface) 38%, #fff 70%, #fff 100%);
  }

  /*
    Halo detrás de la foto: un disco de celeste difuminado que se sale por la
    derecha. Le da al hero un punto de luz sin quitarle blancura al texto.
  */
  /*
    El halo sigue al cursor: el script escribe `--halo-x` y `--halo-y` con un
    desplazamiento pequeño (±2,5 rem) y la transición larga hace que el
    movimiento se sienta como inercia, no como un objeto pegado al puntero.
    Sin cursor —móvil— las variables nunca cambian y queda centrado.
  */
  .hero-halo {
    width: 44rem;
    height: 44rem;
    right: -12rem;
    top: 50%;
    translate: var(--halo-x, 0) calc(-50% + var(--halo-y, 0px));
    border-radius: 9999px;
    background: radial-gradient(closest-side, rgb(0 163 196 / 0.22), rgb(0 163 196 / 0.08) 55%, transparent 72%);
    transition: translate 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-halo {
      translate: 0 -50%;
      transition: none;
    }
  }

  @media (max-width: 63.9rem) {
    .hero-halo {
      width: 26rem;
      height: 26rem;
      right: -10rem;
      top: 62%;
    }
  }
</style>

<script>
  /*
    El halo del hero acompaña al cursor. Se desplaza como mucho 2,5 rem hacia
    cada lado, así que acompaña sin perseguir; la inercia la pone la transición
    larga del CSS. No corre en pantallas táctiles ni con `prefers-reduced-motion`.
  */
  const initHalo = () => {
    const hero = document.querySelector<HTMLElement>('.hero-portada');
    const halo = hero?.querySelector<HTMLElement>('.hero-halo');
    if (!hero || !halo || hero.dataset.haloIniciado === 'true') return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    hero.dataset.haloIniciado = 'true';

    const ALCANCE = 2.5; // rem hacia cada lado
    let pendiente = false;
    let ultimoX = 0;
    let ultimoY = 0;

    const aplicar = () => {
      pendiente = false;
      const caja = hero.getBoundingClientRect();
      // −0,5 a 0,5 respecto del centro del hero.
      const x = (ultimoX - caja.left) / caja.width - 0.5;
      const y = (ultimoY - caja.top) / caja.height - 0.5;
      halo.style.setProperty('--halo-x', `${(x * ALCANCE * 2).toFixed(2)}rem`);
      halo.style.setProperty('--halo-y', `${(y * ALCANCE * 2).toFixed(2)}rem`);
    };

    hero.addEventListener('pointermove', (evento) => {
      ultimoX = evento.clientX;
      ultimoY = evento.clientY;
      // Un cálculo por cuadro: `pointermove` dispara decenas por segundo.
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(aplicar);
      }
    });

    // Al salir del hero, el halo vuelve a su sitio.
    hero.addEventListener('pointerleave', () => {
      halo.style.setProperty('--halo-x', '0rem');
      halo.style.setProperty('--halo-y', '0rem');
    });
  };

  initHalo();
  document.addEventListener('astro:page-load', initHalo);
</script>
