---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import SedeCard from '@/components/SedeCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaDomicilio from '@/components/CtaDomicilio.astro';
import Cifras, { type Cifra } from '@/components/Cifras.astro';
import FranjaLogos from '@/components/FranjaLogos.astro';
import BuscadorExamenes from '@/components/BuscadorExamenes.astro';
import { site, sedes } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';
import { getCollection } from 'astro:content';
import especialidadesData from '@/data/especialidades.json';
import perfiles from '@/data/perfiles.json';
import convenios from '@/data/convenios.json';
import type { IconName } from '@/lib/iconos';

const noticias = (await getCollection('noticias', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const especialidades = especialidadesData.filter((e) => e.enPortada);

/*
  Las cifras salen de los datos reales del sitio donde se puede: el número de
  especialidades viene de especialidades.json y el de sedes de site.ts. Así no
  quedan desactualizadas cuando esos datos cambien.
*/
const cifras: Cifra[] = [
  { valor: 400, sufijo: '+', etiqueta: 'Análisis clínicos disponibles' },
  { valor: especialidadesData.length, etiqueta: 'Especialidades de laboratorio' },
  { valor: sedes.length, etiqueta: `Sedes en ${sedes[0]!.provincia}` },
  { valor: 24, sufijo: ' h', etiqueta: 'Entrega en exámenes de rutina' },
];

const ventajas = [
  {
    icono: 'check' as const,
    titulo: 'Resultados confiables',
    texto: 'Doble validación técnica y controles de calidad en cada corrida.',
  },
  {
    icono: 'reloj' as const,
    titulo: 'Entrega oportuna',
    texto: 'Informes en línea el mismo día en la mayoría de exámenes de rutina.',
  },
  {
    icono: 'usuario' as const,
    titulo: 'Personal profesional',
    texto: 'Bioquímicos y tecnólogos médicos con formación continua.',
  },
  {
    icono: 'monitor' as const,
    titulo: 'Tecnología moderna',
    texto: 'Analizadores automatizados y trazabilidad digital de cada muestra.',
  },
];
---

<BaseLayout
  titulo={`${site.nombre} · Laboratorio clínico en ${site.ciudad}`}
  descripcion={site.descripcion}
  whatsapp="home"
  imagen="/images/Fotoequipo.png"
>
  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="bg-white pt-10 pb-12 lg:pt-16 lg:pb-16 border-b border-line">
    <div class="container-page grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <div class="entrada entrada-1 inline-flex items-center gap-2 rounded-lg bg-brand-soft/60 px-3.5 py-1.5 border border-brand/10">
          <span class="text-xs font-bold tracking-wider text-brand uppercase">
            Nueva imagen, la misma trayectoria
          </span>
        </div>

        <h1 class="entrada entrada-2 mt-4 text-h1 font-extrabold tracking-tight text-brand">
          Resultados confiables para su salud y tranquilidad
        </h1>

        <p class="entrada entrada-3 mt-4 max-w-[540px] text-lead text-neutral leading-relaxed">
          Laboratorio clínico especializado. Equipamiento automatizado de alta precisión, personal certificado y entrega oportuna de sus análisis médicos.
        </p>

        <div class="entrada entrada-4 mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href={whatsappLink('cita')} icon="whatsapp-marca">Agendar cita por WhatsApp</Button>
          <Button href="/soy-paciente/resultados" variant="secondary" icon="documento">
            Ver mis resultados
          </Button>
        </div>

        <BuscadorExamenes id="buscar-hero" class="entrada entrada-4 mt-4" />

        <div class="entrada entrada-5 mt-8 pt-6 border-t border-line grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="flex items-center gap-2.5 text-xs font-semibold text-neutral">
            <Icon name="check" size={16} strokeWidth={2.4} class="text-accent shrink-0" />
            <span>Resultados en línea 24/7</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs font-semibold text-neutral">
            <Icon name="casa" size={16} strokeWidth={2} class="text-accent shrink-0" />
            <span>Muestras a domicilio</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs font-semibold text-neutral">
            <Icon name="reloj" size={16} strokeWidth={2} class="text-accent shrink-0" />
            <span>Entrega el mismo día</span>
          </div>
        </div>
      </div>

      <div class="entrada-imagen relative">
        <img
          src="/images/Fotoequipo.png"
          alt="Sala de equipos y analizadores de ExamLab"
          width="1024"
          height="768"
          fetchpriority="high"
          decoding="async"
          class="h-[clamp(300px,36vw,460px)] w-full rounded-2xl border border-line object-cover shadow-md"
        />
      </div>
    </div>
  </section>

  <!-- ── Accesos rápidos ──────────────────────────────────────────── -->
  <section id="accesos" class="scroll-mt-24 bg-white py-12 lg:py-16">
    <div class="container-page grid grid-cols-1 gap-4.5 sm:grid-cols-2 lg:grid-cols-4 reveal-stagger">
      <ServiceCard
        icono="documento"
        titulo="Resultados en línea"
        descripcion="Consulte y descargue sus informes con su cédula y código de orden."
        cta="Ingresar"
        href="/soy-paciente/resultados"
      />
      <ServiceCard
        icono="calendario"
        titulo="Pedir cita"
        descripcion="Reserve su turno por WhatsApp y evite tiempos de espera."
        cta="Agendar"
        href="/soy-paciente/pedir-cita"
      />
      <ServiceCard
        icono="lupa"
        titulo="Catálogo de exámenes"
        descripcion="Especialidad, muestra, tiempo de entrega y condiciones de cada análisis."
        cta="Buscar"
        href="/catalogo"
      />
      <ServiceCard
        icono="pin"
        titulo="Nuestras sedes"
        descripcion="Puntos de atención en Ambato y Pelileo con horarios extendidos."
        cta="Ver mapa"
        href="/sedes"
      />
    </div>
  </section>

  <!-- ── Especialidades ───────────────────────────────────────────── -->
  <section id="catalogo" class="scroll-mt-24 bg-surface py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Especialidades"
        titulo="Más de 400 análisis clínicos en un solo lugar"
        ctaLabel="Ver catálogo completo"
        ctaHref="/catalogo"
      />
      <div class="mt-9 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 reveal-stagger">
        {
          especialidades.map((especialidad) => (
            <CategoryCard
              icono={especialidad.icono as IconName}
              titulo={especialidad.nombre}
              descripcion={especialidad.descripcion}
              conteo={especialidad.conteo}
              href={`/catalogo?especialidad=${encodeURIComponent(especialidad.nombre)}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Perfiles temáticos ───────────────────────────────────────── -->
  <section id="perfiles" class="scroll-mt-24 bg-white py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Perfiles y chequeos"
        titulo="Paquetes de análisis para su control médico"
        descripcion="Exámenes agrupados para agilizar su diagnóstico con una sola toma de muestra."
      />
      <div class="mt-9 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 reveal-stagger">
        {
          perfiles.map((perfil) => (
            <a
              href={whatsappLink('chequeos')}
              target="_blank"
              rel="noopener"
              class="group flex flex-col justify-between rounded-xl border border-line bg-white p-6 transition-all duration-200 hover:border-brand hover:shadow-md"
            >
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-brand transition-colors duration-200 group-hover:text-accent">
                    <Icon name={perfil.icono as IconName} size={24} strokeWidth={2} />
                  </span>
                  <span class="rounded-full bg-brand-soft/70 px-2.5 py-1 text-xs font-semibold text-brand">
                    {perfil.publico}
                  </span>
                </div>
                <span class="mt-4 block text-base font-bold text-brand">{perfil.nombre}</span>
                <span class="mt-2 block text-xs leading-relaxed text-neutral">
                  {perfil.descripcion}
                </span>
              </div>
              <div class="mt-5 flex items-center gap-1.5 pt-3 text-xs font-semibold text-brand transition-colors duration-200 group-hover:text-accent border-t border-line/60">
                <Icon name="whatsapp-marca" size={14} class="text-whatsapp" />
                <span>Consultar por WhatsApp</span>
                <Icon
                  name="flecha"
                  size={13}
                  strokeWidth={2.4}
                  class="text-accent transition-transform duration-200 group-hover:translate-x-1"
                />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Domicilio y emergencias ──────────────────────────────────── -->
  <div class="reveal">
    <CtaDomicilio />
  </div>

  <!-- ── Cifras ───────────────────────────────────────────────────── -->
  <section class="border-b border-line bg-white pt-section pb-10">
    <div class="container-page reveal">
      <Cifras cifras={cifras} />
    </div>
  </section>

  <!-- ── Por qué elegirnos ────────────────────────────────────────── -->
  <section class="bg-white py-section">
    <div class="container-page grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-14 reveal">
      <div>
        <img
          src="/images/Fotolaboratorio.png"
          alt="Profesionales de ExamLab analizando muestras"
          width="1024"
          height="768"
          loading="lazy"
          decoding="async"
          class="h-[clamp(300px,38vw,460px)] w-full rounded-2xl border border-line object-cover shadow-sm"
        />
      </div>

      <div>
        <span class="inline-flex items-center gap-2 rounded-lg bg-brand-soft/60 px-3 py-1 text-xs font-semibold text-brand border border-brand/10">
          Calidad Garantizada
        </span>
        <h2 class="mt-3 text-h2 font-bold text-brand">Precisión clínica y procesamiento automatizado</h2>
        <p class="mt-3 text-sm text-neutral leading-relaxed">
          Sometemos cada prueba a rigurosos controles de calidad internos y externos para garantizar resultados exactos.
        </p>

        <div class="mt-7 grid grid-cols-1 gap-6 sm:grid-cols-2 reveal-stagger">
          {
            ventajas.map((ventaja) => (
              <div class="flex items-start gap-3.5">
                <span class="mt-0.5 flex shrink-0 items-center justify-center text-brand">
                  <Icon name={ventaja.icono} size={22} strokeWidth={2} />
                </span>
                <div>
                  <h3 class="text-sm font-bold text-brand">{ventaja.titulo}</h3>
                  <p class="mt-1 text-xs leading-relaxed text-neutral">{ventaja.texto}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── Convenios ────────────────────────────────────────────────── -->
  <section id="convenios" class="scroll-mt-24 bg-surface py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Convenios"
        titulo="Atención con principales aseguradoras"
        descripcion="Consulte la cobertura de su seguro antes de su toma de muestra."
        ctaLabel="Confirmar cobertura"
        ctaHref={whatsappLink('convenios')}
      />
      <div class="mt-9 rounded-2xl border border-line bg-white px-6 py-8">
        <FranjaLogos logos={convenios} />
      </div>
      <p class="mt-4 text-[13px] text-neutral">
        Los logos rotan automáticamente. Pase el cursor sobre uno para verlo a color.
      </p>
    </div>
  </section>

  <!-- ── Sedes ────────────────────────────────────────────────────── -->
  <section id="sedes" class="scroll-mt-24 bg-white py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Puntos de atención"
        titulo="Sedes en Ambato y Pelileo"
        descripcion="Instalaciones cómodas y atención ágil con horarios extendidos."
      />
      <div class="mt-9 grid grid-cols-1 gap-6 md:grid-cols-2 reveal-stagger">
        {sedes.map((sede) => <SedeCard sede={sede} />)}
      </div>
    </div>
  </section>

  <!-- ── Noticias ─────────────────────────────────────────────────── -->
  <section id="noticias" class="scroll-mt-24 bg-surface py-section">
    <div class="container-page reveal">
      <SectionHeading
        eyebrow="Noticias y Salud"
        titulo="Información y prevención médica"
        ctaLabel="Ver todas las noticias"
        ctaHref="/noticias"
      />
      <div class="mt-9 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 reveal-stagger">
        {
          noticias.map((nota, i) => (
            <NewsCard
              slug={nota.id}
              titulo={nota.data.titulo}
              descripcion={nota.data.descripcion}
              categoria={nota.data.categoria}
              fecha={nota.data.fecha}
              imagen={nota.data.imagen}
              indice={i + 1}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
