---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { whatsappLink } from '@/lib/whatsapp';
---

<BaseLayout titulo="Página no encontrada" descripcion="La página que busca no existe o cambió de dirección." noindex>
  <section class="bg-white py-section">
    <div class="container-page max-w-[640px] text-center">
      <h1 class="text-h1 font-bold text-brand">Página no encontrada</h1>
      <p class="mx-auto mt-4 max-w-[460px] text-lead text-neutral">
        La dirección que abrió no existe o cambió. Puede volver al inicio o buscar directamente el
        examen que necesita.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <Button href="/catalogo" icon="lupa">Buscar un examen</Button>
        <Button href="/" variant="secondary">Volver al inicio</Button>
        <Button href={whatsappLink('general')} variant="secondary" icon="whatsapp-marca">
          Escribirnos
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
