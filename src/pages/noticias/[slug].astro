---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsCard from '@/components/NewsCard.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { articleSchema, breadcrumbSchema } from '@/lib/schema';
import { whatsappNoticia } from '@/lib/whatsapp';
import { formatoFechaLarga, fechaISO } from '@/lib/fechas';

export async function getStaticPaths() {
  const notas = await getCollection('noticias', ({ data }) => !data.borrador);
  return notas.map((nota) => ({
    params: { slug: nota.id },
    props: { nota },
  }));
}

interface Props {
  nota: CollectionEntry<'noticias'>;
}

const { nota } = Astro.props;
const { Content } = await render(nota);

const otras = (await getCollection('noticias', ({ data }) => !data.borrador))
  .filter((otra) => otra.id !== nota.id)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const waHref = whatsappNoticia(nota.data.titulo);

const schema = [
  breadcrumbSchema([
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Noticias', href: '/noticias' },
    { nombre: nota.data.titulo, href: `/noticias/${nota.id}` },
  ]),
  articleSchema({
    titulo: nota.data.titulo,
    descripcion: nota.data.descripcion,
    fecha: nota.data.fecha,
    actualizado: nota.data.actualizado,
    autor: nota.data.autor,
    imagen: nota.data.imagen,
    slug: nota.id,
  }),
];
---

<BaseLayout
  titulo={nota.data.titulo}
  descripcion={nota.data.descripcion}
  whatsapp="noticias"
  imagen={nota.data.imagen ?? '/images/Fotolaboratorio.png'}
  schema={schema}
>
  <article>
    <header class="bg-brand">
      <div class="container-page py-10 lg:py-14">
        <nav aria-label="Ruta de navegación" class="mb-6">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[12.5px] text-white/60">
            <li><a href="/" class="transition-colors hover:text-accent-light">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li>
              <a href="/noticias" class="transition-colors hover:text-accent-light">Noticias</a>
            </li>
          </ol>
        </nav>

        <span class="flex flex-wrap items-center gap-2.5 text-xs font-bold">
          <span class="rounded-lg bg-white/12 px-2.5 py-1.5 text-accent-light uppercase">
            {nota.data.categoria}
          </span>
          <time datetime={fechaISO(nota.data.fecha)} class="text-white/55">
            {formatoFechaLarga(nota.data.fecha)}
          </time>
        </span>

        <h1 class="mt-4 max-w-[820px] text-h1 font-bold text-white">{nota.data.titulo}</h1>
        <p class="mt-5 max-w-[640px] text-lead text-white/80">{nota.data.descripcion}</p>
        <p class="mt-6 flex items-center gap-2.5 text-[13.5px] text-white/60">
          <Icon name="usuario" size={16} class="text-accent-light" />
          {nota.data.autor}
          {
            nota.data.actualizado && (
              <span>· Actualizado el {formatoFechaLarga(nota.data.actualizado)}</span>
            )
          }
        </p>
      </div>
    </header>

    {
      nota.data.imagen && (
        <div class="bg-white pt-10">
          <div class="container-page">
            <img
              src={nota.data.imagen}
              alt={nota.data.imagenAlt ?? ''}
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
              class="h-[clamp(220px,32vw,420px)] w-full rounded-[28px] object-cover"
            />
          </div>
        </div>
      )
    }

    <div class="bg-white py-12 lg:py-16">
      <div class="container-page grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px] lg:gap-14">
        <div class="prose-examlab max-w-[720px]">
          <Content />
        </div>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="rounded-3xl bg-surface p-6">
            <h2 class="text-[17px] font-bold text-brand">¿Le quedó alguna duda?</h2>
            <p class="mt-2.5 text-[14px] leading-relaxed text-neutral">
              Escríbanos por WhatsApp mencionando este artículo y le respondemos.
            </p>
            <Button href={waHref} icon="whatsapp-marca" size="sm" full class="mt-4">
              Consultar por WhatsApp
            </Button>
          </div>

          <div class="mt-4 rounded-3xl border border-line p-6">
            <h2 class="text-[17px] font-bold text-brand">Agende su examen</h2>
            <p class="mt-2.5 text-[14px] leading-relaxed text-neutral">
              Consulte la preparación y el precio de cada análisis en el catálogo.
            </p>
            <Button href="/catalogo" variant="secondary" size="sm" full class="mt-4">
              Ir al catálogo
            </Button>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {
    otras.length > 0 && (
      <section class="bg-surface py-section">
        <div class="container-page">
          <h2 class="text-h2 font-bold text-brand">Siga leyendo</h2>
          <div class="mt-8 grid grid-cols-1 gap-5.5 md:grid-cols-2 lg:grid-cols-3">
            {otras.map((otra, i) => (
              <NewsCard
                slug={otra.id}
                titulo={otra.data.titulo}
                descripcion={otra.data.descripcion}
                categoria={otra.data.categoria}
                fecha={otra.data.fecha}
                imagen={otra.data.imagen}
                indice={i + 1}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
