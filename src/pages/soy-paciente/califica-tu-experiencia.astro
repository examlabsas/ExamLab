---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { site, sedes } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';
import { breadcrumbSchema } from '@/lib/schema';

const schema = [
  breadcrumbSchema([
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Soy paciente', href: '/soy-paciente' },
    { nombre: 'Califica tu experiencia', href: '/soy-paciente/califica-tu-experiencia' },
  ]),
];

const aspectos = [
  { icono: 'reloj' as const, texto: 'El tiempo de espera para su atención' },
  { icono: 'usuario' as const, texto: 'El trato del personal de toma de muestra' },
  { icono: 'documento' as const, texto: 'La claridad de las indicaciones que recibió' },
  { icono: 'monitor' as const, texto: 'La facilidad para acceder a sus resultados' },
];
---

<BaseLayout
  titulo="Califica tu experiencia"
  descripcion="Cuéntenos cómo fue su atención en ExamLab. Su reseña en Google nos ayuda a mejorar y orienta a otros pacientes."
  whatsapp="califica"
  schema={schema}
>
  <PageHero
    eyebrow="Califica tu experiencia"
    titulo="Su opinión mejora nuestro servicio"
    descripcion="Nos toma un minuto leerla y nos sirve todo el año. Cuéntenos qué salió bien y qué debemos corregir."
    migas={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Soy paciente', href: '/soy-paciente' },
      { nombre: 'Califica tu experiencia', href: '/soy-paciente/califica-tu-experiencia' },
    ]}
  />

  <!-- Dos caminos -->
  <section class="bg-white py-section">
    <div class="container-page grid grid-cols-1 gap-5 lg:grid-cols-2">
      <div class="flex flex-col gap-4 rounded-[28px] border border-line bg-white p-7 lg:p-9">
        <span class="flex h-13 w-13 items-center justify-center rounded-2xl bg-accent-soft text-accent-dark">
          <Icon name="check" size={26} />
        </span>
        <h2 class="text-h3 font-bold text-brand">¿Quedó conforme?</h2>
        <p class="text-[15px] leading-relaxed text-neutral">
          Déjenos una reseña pública en Google. Nos ayuda a que más familias de {site.provincia}
          encuentren el laboratorio y confíen en él.
        </p>
        <ul class="flex flex-col gap-2.5">
          {
            aspectos.map((aspecto) => (
              <li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-neutral">
                <Icon name={aspecto.icono} size={17} class="mt-0.5 text-accent" />
                {aspecto.texto}
              </li>
            ))
          }
        </ul>
        <div class="mt-auto pt-3">
          <Button href={site.resenasGoogle} icon="usuarios" full>
            Dejar mi reseña en Google
          </Button>
        </div>
      </div>

      <div class="flex flex-col gap-4 rounded-[28px] bg-brand p-7 lg:p-9">
        <span class="flex h-13 w-13 items-center justify-center rounded-2xl bg-alert/20 text-alert-light">
          <Icon name="alerta" size={26} />
        </span>
        <h2 class="text-h3 font-bold text-white">¿Algo no salió bien?</h2>
        <p class="text-[15px] leading-relaxed text-white/75">
          Preferimos enterarnos directamente. Escríbanos por WhatsApp contándonos qué pasó, en qué
          sede y cuándo. Revisamos cada caso y le respondemos con lo que vamos a corregir.
        </p>
        <p class="text-[13.5px] leading-relaxed text-white/60">
          Si su reclamo requiere un trámite formal, se lo indicamos por el mismo canal y le damos
          seguimiento hasta cerrarlo.
        </p>
        <div class="mt-auto pt-3">
          <Button href={whatsappLink('califica')} variant="blanco" icon="whatsapp-marca" full>
            Contarnos qué pasó
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Reseñas por sede -->
  <section class="bg-surface py-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Reseñas por sede"
        titulo="Califique la sede donde le atendieron"
        descripcion="Cada sede tiene su propia ficha en Google. Elegir la correcta ayuda a que su comentario llegue al equipo que le atendió."
      />
      <div class="mt-9 grid grid-cols-1 gap-5 md:grid-cols-2">
        {
          sedes.map((sede) => (
            <div class="flex flex-col gap-3 rounded-3xl bg-white p-6 shadow-card">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent-soft text-accent-dark">
                <Icon name="pin" size={23} />
              </span>
              <h3 class="text-[17px] font-bold text-brand">{sede.nombre}</h3>
              <p class="text-[13.8px] leading-relaxed text-neutral">
                {sede.direccion} · {sede.ciudad}
              </p>
              <div class="mt-auto pt-3">
                <Button href={site.resenasGoogle} variant="secondary" size="sm" full>
                  Calificar esta sede
                </Button>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-[13px] leading-relaxed text-neutral">
        Pendiente de Fase 3: enlazar el identificador de Google Business Profile de cada sede.
      </p>
    </div>
  </section>
</BaseLayout>
