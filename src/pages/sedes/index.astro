---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SedeCard from '@/components/SedeCard.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { site, sedes } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';
import { breadcrumbSchema } from '@/lib/schema';

const schema = [
  breadcrumbSchema([
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Sedes', href: '/sedes' },
  ]),
];

const ciudades = [...new Set(sedes.map((s) => s.ciudad))].join(' y ');
---

<BaseLayout
  titulo="Puntos de atención"
  descripcion={`Direcciones, mapas, horarios y teléfonos de las sedes de ExamLab en ${ciudades}.`}
  whatsapp="sedes"
  schema={schema}
>
  <PageHero
    foto="matriz-ficoa-fachada"
    eyebrow="Puntos de atención"
    titulo={`Nuestras sedes en ${ciudades}`}
    descripcion="Horarios extendidos de lunes a sábado y toma de muestra a domicilio con agendamiento previo."
    migas={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Sedes', href: '/sedes' },
    ]}
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button href={whatsappLink('sedes')} icon="whatsapp-marca">Confirmar horario</Button>
      <Button href={whatsappLink('domicilio')} variant="sobreOscuro" icon="whatsapp-marca">
        Quiero toma a domicilio
      </Button>
    </div>
  </PageHero>

  <section class="bg-surface py-section">
    <div class="container-page">
      <div class="reveal-stagger grid grid-cols-1 gap-5 md:grid-cols-2">
        {sedes.map((sede) => <SedeCard sede={sede} conWhatsApp />)}
      </div>
    </div>
  </section>

  <!-- Datos generales -->
  <section class="bg-white py-section">
    <div class="container-page grid grid-cols-1 gap-9 lg:grid-cols-2 lg:gap-14">
      <div>
        <SectionHeading
          eyebrow="Contacto general"
          titulo="Una sola línea para todas las sedes"
          descripcion="Si no sabe qué sede le queda mejor o necesita coordinar una toma a domicilio, escríbanos y le ayudamos."
        />
        <div class="mt-7 flex flex-col gap-4">
          <a
            href={`tel:${site.telefonoE164}`}
            class="flex items-center gap-4 rounded-xl border border-line bg-white p-5 transition-colors hover:border-accent"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-accent-soft text-accent-dark">
              <Icon name="telefono" size={20} />
            </span>
            <span>
              <span class="block text-xs font-bold tracking-[0.6px] text-neutral uppercase">
                Central telefónica
              </span>
              <span class="mt-0.5 block text-lg font-bold text-brand">{site.telefono}</span>
            </span>
          </a>
          <a
            href={`tel:${site.emergenciasE164}`}
            class="flex items-center gap-4 rounded-xl border border-line bg-white p-5 transition-colors hover:border-accent"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-alert-soft text-alert-dark">
              <Icon name="mas" size={20} />
            </span>
            <span>
              <span class="block text-xs font-bold tracking-[0.6px] text-neutral uppercase">
                Urgencias y domicilio
              </span>
              <span class="mt-0.5 block text-lg font-bold text-brand">{site.emergencias}</span>
            </span>
          </a>
          <a
            href={`mailto:${site.email}`}
            class="flex items-center gap-4 rounded-xl border border-line bg-white p-5 transition-colors hover:border-accent"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-accent-soft text-accent-dark">
              <Icon name="correo" size={20} />
            </span>
            <span>
              <span class="block text-xs font-bold tracking-[0.6px] text-neutral uppercase">
                Correo
              </span>
              <span class="mt-0.5 block text-lg font-bold text-brand">{site.email}</span>
            </span>
          </a>
        </div>
      </div>

      <div class="rounded-xl bg-surface p-7 lg:p-9">
        <h2 class="text-h3 font-bold text-brand">Horario de atención</h2>
        <div class="mt-6 flex flex-col divide-y divide-line">
          {
            sedes.map((sede) => (
              <div class="flex flex-wrap items-start justify-between gap-3 py-4 first:pt-0">
                <span class="text-base font-bold text-brand">{sede.nombre}</span>
                <span class="text-right text-sm leading-relaxed text-neutral">
                  {sede.horarios.map((h) => (
                    <>
                      {h.dias} {h.horas}
                      <br />
                    </>
                  ))}
                </span>
              </div>
            ))
          }
        </div>
        <p class="mt-6 rounded-xl bg-white p-4 text-sm leading-relaxed text-neutral">
          La toma de muestra a domicilio se agenda hasta las 17:00 del día anterior. En feriados
          atendemos únicamente urgencias coordinadas por teléfono.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
