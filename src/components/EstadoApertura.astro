---
/**
 * Indicador "Abierto ahora / Cerrado".
 *
 * Calcula el estado con la hora real de Ecuador (America/Guayaquil), no con la
 * del visitante: alguien que consulte desde otro país debe ver si el
 * laboratorio está abierto allá, no acá.
 *
 * Como el sitio es estático, el cálculo va en el navegador. Sin JavaScript se
 * muestra el horario resumido, que sigue siendo información útil.
 */
import { ZONA_HORARIA, type HorarioSemanal, type FechaEspecial } from '@/lib/site';

interface Props {
  horario: HorarioSemanal;
  /**
   * Feriados y jornadas distintas que afectan a esta sede. Sin ellas el
   * indicador anuncia «Abierto» un día en que el laboratorio está cerrado.
   */
  fechasEspeciales?: FechaEspecial[];
  /** Texto de reserva mientras no hay JavaScript. */
  respaldo: string;
  /** `true` sobre fondo azul (barra superior). */
  oscuro?: boolean;
  class?: string;
}

const {
  horario,
  fechasEspeciales = [],
  respaldo,
  oscuro = false,
  class: className,
} = Astro.props;
---

<span
  class:list={['inline-flex items-center gap-2', className]}
  data-apertura
  data-horario={JSON.stringify(horario)}
  data-especiales={JSON.stringify(fechasEspeciales)}
  data-zona={ZONA_HORARIA}
>
  {/* Cuando el laboratorio está abierto, el punto late (ver `.punto-vivo` en global.css). */}
  <span
    class:list={[
      'punto-vivo relative h-2 w-2 flex-none rounded-full bg-current opacity-60 transition-colors',
      oscuro ? 'text-white/75' : 'text-neutral',
    ]}
    data-punto
    aria-hidden="true"></span>
  <span data-texto>{respaldo}</span>
</span>

<script>
  /*
    El reloj del estado «Abierto / Cerrado».

    Todo vive en el ámbito del módulo, que se evalúa una sola vez. Antes estaba
    dentro de la función de arranque y esa función corre en cada `astro:page-load`:
    con las transiciones de página se creaba un `setInterval` nuevo por
    navegación —dos ya en la primera carga— y ninguno se limpiaba. Los viejos
    seguían repintando nodos de páginas ya descartadas, que además quedaban
    retenidos en memoria. Medido con cinco navegaciones: cinco intervalos vivos.

    Ahora hay un único intervalo para toda la sesión y consulta el DOM en cada
    pulso, así que siempre apunta a la página que se está viendo.
  */
  type Tramo = { abre: string; cierra: string };
  type Franja = Tramo[] | null;
  type FechaEspecial = { fecha: string; motivo: string; franja: Franja };

  const aMinutos = (hhmm: string) => {
    const [h, m] = hhmm.split(':').map(Number);
    return (h ?? 0) * 60 + (m ?? 0);
  };

  /** Día y minutos actuales en la zona horaria del laboratorio. */
  const ahoraEnZona = (zona: string) => {
    const partes = new Intl.DateTimeFormat('en-US', {
      timeZone: zona,
      weekday: 'short',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date());

    const buscar = (tipo: string) => partes.find((p) => p.type === tipo)?.value ?? '';
    const dias: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
    // A las 24:00 algunos navegadores devuelven "24"; se normaliza a 0.
    const hora = Number(buscar('hour')) % 24;

    return {
      dia: dias[buscar('weekday')] ?? 0,
      minutos: hora * 60 + Number(buscar('minute')),
      fecha: `${buscar('year')}-${buscar('month')}-${buscar('day')}`,
    };
  };

  const nombreDia = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];

  /** Suma días a una fecha `AAAA-MM-DD` sin que la zona del visitante estorbe. */
  const sumarDias = (fecha: string, dias: number) => {
    const [a, m, d] = fecha.split('-').map(Number);
    const t = new Date(Date.UTC(a!, m! - 1, d!));
    t.setUTCDate(t.getUTCDate() + dias);
    return t.toISOString().slice(0, 10);
  };

  const calcular = (semana: Franja[], especiales: FechaEspecial[], zona: string) => {
    const { dia, minutos, fecha } = ahoraEnZona(zona);

    /*
      Una excepción manda sobre el patrón semanal: puede cerrar un día que
      normalmente abre, o cambiarle el horario. Si no hay ninguna para esa
      fecha, rige la semana de siempre.
    */
    const franjaDe = (f: string, diaSemana: number): Franja => {
      const excepcion = especiales.find((e) => e.fecha === f);
      return excepcion ? excepcion.franja : (semana[diaSemana] ?? null);
    };

    const motivoDe = (f: string) => especiales.find((e) => e.fecha === f)?.motivo;

    const hoy = franjaDe(fecha, dia);

    if (hoy) {
      for (const tramo of hoy) {
        const abre = aMinutos(tramo.abre);
        const cierra = aMinutos(tramo.cierra);

        if (minutos >= abre && minutos < cierra) {
          const faltan = cierra - minutos;
          return {
            abierto: true,
            texto: faltan <= 60 ? `Cierra en ${faltan} min` : `Abierto · cierra ${tramo.cierra}`,
          };
        }
      }
      // No está dentro de ningún tramo: puede ser antes del primero o, si
      // hay pausa de mediodía, estar en la pausa entre dos tramos.
      const siguiente = hoy.find((t) => minutos < aMinutos(t.abre));
      if (siguiente) {
        return { abierto: false, texto: `Cerrado · abre hoy ${siguiente.abre}` };
      }
    }

    /*
      Cerrado: se busca el próximo día con atención, saltándose también los
      feriados. Se miran 14 días y no 7 porque un puente puede encadenar varios
      cierres seguidos y dejar la próxima apertura fuera de la semana.
    */
    const motivoHoy = motivoDe(fecha);
    for (let i = 1; i <= 14; i++) {
      const otraFecha = sumarDias(fecha, i);
      const franja = franjaDe(otraFecha, (dia + i) % 7);
      if (!franja || franja.length === 0) continue;

      const cuando = i === 1 ? 'mañana' : `el ${nombreDia[(dia + i) % 7]}`;
      const cola = `abre ${cuando} ${franja[0]!.abre}`;
      // Si hoy es feriado se dice, que es lo que explica el cierre.
      return {
        abierto: false,
        texto: motivoHoy ? `Cerrado por ${motivoHoy} · ${cola}` : `Cerrado · ${cola}`,
      };
    }
    return { abierto: false, texto: motivoHoy ? `Cerrado por ${motivoHoy}` : 'Cerrado' };
  };

  /** Repinta todos los indicadores que haya ahora mismo en la página. */
  const pintar = () => {
    for (const nodo of document.querySelectorAll<HTMLElement>('[data-apertura]')) {
      let semana: Franja[];
      try {
        semana = JSON.parse(nodo.dataset.horario ?? '[]');
      } catch {
        continue;
      }

      let especiales: FechaEspecial[] = [];
      try {
        especiales = JSON.parse(nodo.dataset.especiales ?? '[]');
      } catch {
        especiales = [];
      }

      const { abierto, texto } = calcular(
        semana,
        especiales,
        nodo.dataset.zona ?? 'America/Guayaquil',
      );
      const punto = nodo.querySelector<HTMLElement>('[data-punto]');
      const etiqueta = nodo.querySelector<HTMLElement>('[data-texto]');

      if (etiqueta) etiqueta.textContent = texto;
      if (punto) {
        punto.classList.remove('opacity-60');
        punto.style.color = abierto ? '#25D366' : '#E1251B';
      }
      nodo.dataset.abierto = String(abierto);
    }
  };

  pintar();
  document.addEventListener('astro:page-load', pintar);

  // Un solo intervalo por sesión, para que el estado no quede congelado.
  window.setInterval(pintar, 60_000);
</script>
