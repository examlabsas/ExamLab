---
/** Franja azul: exámenes a domicilio + atención de emergencia. */
import Icon from './Icon.astro';
import FondoGotas from './FondoGotas.astro';
import PulsoEcg from './PulsoEcg.astro';
import { site } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';
---

<section id="domicilio" class="relative scroll-mt-24 overflow-hidden bg-brand py-12 text-white">
  <FondoGotas intensidad="suave" />
  <PulsoEcg class="h-20 text-white opacity-15" />
  <div class="container-page relative grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-12">
    <!-- Domicilio -->
    <div class="flex flex-col justify-between rounded-xl bg-white/5 border border-white/15 p-7">
      <div>
        <div class="inline-flex items-center gap-2 text-accent-light">
          <Icon name="casa" size={22} strokeWidth={2} />
          {/* Texto en blanco: el cian claro se queda en 3,99:1 sobre esta capa. */}
          <span class="text-xs font-semibold tracking-wider text-white uppercase">
            Servicio a domicilio
          </span>
        </div>
        <h3 class="mt-3 text-2xl font-bold text-white">Toma de muestras a domicilio</h3>
        <p class="mt-2.5 max-w-[460px] text-sm leading-relaxed text-white/80">
          Atención en la comodidad de su hogar u oficina en {site.ciudad} y zonas aledañas. Agende su turno con previa confirmación por WhatsApp.
        </p>
      </div>
      <div class="mt-6">
        <a
          href={whatsappLink('domicilio')}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center gap-2.5 rounded-lg bg-accent-dark px-5 py-3.5 text-sm font-bold text-white transition-colors duration-200 hover:bg-accent-deep"
        >
          <Icon name="whatsapp-marca" size={16} />
          Agendar muestra a domicilio
        </a>
      </div>
    </div>

    <!-- Emergencias -->
    <div class="relative flex flex-col justify-between overflow-hidden rounded-xl bg-alert/15 border border-alert/30 p-7" id="emergencias">
      {/* Trazo de ECG al pie de la tarjeta, en rojo claro y muy tenue. */}
      <PulsoEcg class="text-alert-light opacity-30" />
      <div class="relative">
        <div class="inline-flex items-center gap-2 text-alert-light">
          <span class="h-2 w-2 rounded-full bg-alert-light"></span>
          {/* Texto en blanco: el rojo claro se queda en 3,01:1 sobre esta capa. */}
          <span class="text-xs font-semibold tracking-wider text-white uppercase">
            Atención prioritaria
          </span>
        </div>
        <h3 class="mt-3 text-2xl font-bold text-white">Exámenes de urgencia</h3>
        <p class="mt-2.5 max-w-[460px] text-sm leading-relaxed text-white/80">
          Procesamiento prioritario en casos de emergencia clínica con entrega oportuna de resultados el mismo día.
        </p>
      </div>
      <div class="relative mt-6">
        <a
          href={`tel:${site.emergenciasE164}`}
          class="inline-flex items-center gap-3 rounded-lg bg-alert px-5 py-3.5 text-sm font-bold text-white transition-colors duration-200 hover:bg-alert-dark"
        >
          <Icon name="telefono" size={17} />
          Llamar a Urgencias: {site.emergencias}
        </a>
      </div>
    </div>
  </div>
</section>
