---
import { formatoFecha } from '@/lib/fechas';
import { foto as fotoDe, type NombreFoto } from '@/lib/fotos';

interface Props {
  slug: string;
  titulo: string;
  descripcion: string;
  categoria: string;
  fecha: Date;
  foto?: NombreFoto;
}

const { slug, titulo, descripcion, categoria, fecha, foto } = Astro.props;
const imagen = foto ? fotoDe(foto) : undefined;
---

<a
  href={`/noticias/${slug}`}
  class="group flex flex-col overflow-hidden rounded-lg border border-line bg-white transition-colors duration-200 hover:border-accent-dark"
>
  {
    imagen ? (
      <img
        {...imagen}
        alt=""
        style={`view-transition-name: noticia-${slug}`}
        sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw"
        loading="lazy"
        decoding="async"
        class="h-43 w-full object-cover"
      />
    ) : (
      /* Sin imagen no se dibuja un marcador de maqueta: se deja el hueco liso. */
      <div class="h-43 bg-surface" />
    )
  }
  <div class="p-5.5">
    <span class="flex items-center gap-2.5 text-xs font-bold text-accent-dark">
      <span class="uppercase">{categoria}</span>
      <span class="text-neutral">{formatoFecha(fecha)}</span>
    </span>
    {/*
      Encabezado de verdad, no un <span> con aspecto de título: así la lista de
      noticias se puede recorrer saltando de encabezado en encabezado con un
      lector de pantalla. Es `h3` porque la sección que la contiene lleva `h2`.
    */}
    <h3 class="mt-2.5 text-lg leading-snug font-bold text-brand">{titulo}</h3>
    <p class="mt-2 text-sm leading-relaxed text-neutral">{descripcion}</p>
  </div>
</a>
