---
/**
 * Botón flotante de WhatsApp.
 * Cada página pasa la sección para que el mensaje precargado sea distinto.
 */
import Icon from './Icon.astro';
import { whatsappLink, whatsappUrl, type SeccionWhatsApp } from '@/lib/whatsapp';

interface Props {
  seccion?: SeccionWhatsApp;
  /** Mensaje libre; tiene prioridad sobre `seccion`. */
  mensaje?: string;
  etiqueta?: string;
}

const { seccion = 'general', mensaje, etiqueta = 'Escríbenos' } = Astro.props;
const href = mensaje ? whatsappUrl(mensaje) : whatsappLink(seccion);
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="wa-float pointer-events-auto mr-5 mb-5 flex items-center gap-2.5 rounded-full bg-whatsapp-boton px-4 py-3.5 text-sm font-bold text-white shadow-[0_12px_30px_rgb(15_125_111/0.38)] transition-colors duration-200 hover:bg-whatsapp-dark menu:px-4.5"
>
  {/* Anillo que se expande y desvanece cada pocos segundos (ver `.wa-anillo`). */}
  <span class="wa-anillo" aria-hidden="true"></span>
  <Icon name="whatsapp-marca" size={22} />
  <span class="hidden menu:inline">{etiqueta}</span>
</a>

