---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import {
  site,
  sedes,
  footerEnlaces,
  footerServicios,
  footerLegales,
} from '@/lib/site';

const matriz = sedes[0]!;
const anio = new Date().getFullYear();

const redes = [
  { etiqueta: 'Facebook', abrev: 'fb', href: site.redes.facebook },
  { etiqueta: 'Instagram', abrev: 'ig', href: site.redes.instagram },
  { etiqueta: 'TikTok', abrev: 'tt', href: site.redes.tiktok },
];
---

<footer class="bg-brand text-white/70">
  <div
    class="container-page grid grid-cols-1 gap-y-8 py-12 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-4 lg:gap-x-12 lg:py-16"
  >
    <div>
      <Logo box={50} variant="oscuro" razonSocial />
      <p class="mt-4 max-w-[290px] text-sm leading-relaxed">
        Años de trayectoria al servicio de la salud de las familias de {site.ciudad} y {site.provincia}.
      </p>
      <div class="mt-5 flex gap-2.5">
        {
          redes.map((red) => (
            <a
              href={red.href}
              target="_blank"
              rel="noopener"
              aria-label={red.etiqueta}
              class="flex h-9.5 w-9.5 items-center justify-center rounded-full border border-white/25 text-[12.5px] font-bold text-white transition-colors hover:border-accent hover:bg-accent"
            >
              {red.abrev}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <span class="block text-xs font-bold tracking-[1.6px] text-white uppercase">
        Enlaces rápidos
      </span>
      <div class="mt-4 flex flex-col gap-3">
        {
          footerEnlaces.map((enlace) => (
            <a
              href={enlace.href}
              class="text-[14.2px] text-white/70 transition-colors hover:text-accent-light"
            >
              {enlace.label}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <span class="block text-xs font-bold tracking-[1.6px] text-white uppercase">Servicios</span>
      <div class="mt-4 flex flex-col gap-3">
        {
          footerServicios.map((enlace) => (
            <a
              href={enlace.href}
              target={enlace.href.startsWith('http') ? '_blank' : undefined}
              rel={enlace.href.startsWith('http') ? 'noopener' : undefined}
              class="text-[14.2px] text-white/70 transition-colors hover:text-accent-light"
            >
              {enlace.label}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <span class="block text-xs font-bold tracking-[1.6px] text-white uppercase">Contacto</span>
      <div class="mt-4 flex flex-col gap-3.5">
        <span class="flex gap-2.5 text-[14.2px] leading-relaxed">
          <Icon name="pin" size={17} class="mt-0.5 text-accent" />
          <span>{matriz.direccion}<br />{site.ciudad}, {site.provincia}</span>
        </span>
        <a
          href={`tel:${site.telefonoE164}`}
          class="text-base font-bold text-white transition-colors hover:text-accent-light"
        >
          {site.telefono}
        </a>
        <a
          href={`mailto:${site.email}`}
          class="text-[14.2px] text-white/70 transition-colors hover:text-accent-light"
        >
          {site.email}
        </a>
        <span class="text-[13.5px] leading-relaxed text-white/60">
          {matriz.horarios[0]}<br />{matriz.horarios[1]}
        </span>
      </div>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div
      class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2.5 py-5 pb-6"
    >
      <span class="text-[12.8px] text-white/55">
        © {anio} {site.nombre} · Laboratorio clínico · {site.ciudad}, {site.pais}
      </span>
      <span class="flex flex-wrap gap-x-5 gap-y-2.5">
        {
          footerLegales.map((enlace) => (
            <a
              href={enlace.href}
              class="text-[12.8px] text-white/60 transition-colors hover:text-accent-light"
            >
              {enlace.label}
            </a>
          ))
        }
      </span>
    </div>
  </div>
</footer>
