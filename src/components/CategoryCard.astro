---
/** Tarjeta de categoría del catálogo de exámenes. */
import Icon from './Icon.astro';
import type { IconName } from '@/lib/iconos';

interface Props {
  icono: IconName;
  titulo: string;
  descripcion: string;
  conteo: string;
  href?: string;
}

const { icono, titulo, descripcion, conteo, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  {...href ? { href } : {}}
  class="group flex flex-col justify-between rounded-xl border border-line bg-white p-6 transition-all duration-200 hover:border-brand hover:shadow-md"
>
  <div>
    <div class="flex items-center justify-between">
      <span class="text-brand transition-colors duration-200 group-hover:text-accent">
        <Icon name={icono} size={24} strokeWidth={2} />
      </span>
      <span class="rounded-full bg-brand-soft/70 px-2.5 py-1 text-xs font-semibold text-brand">
        {conteo}
      </span>
    </div>
    <h3 class="mt-4 text-base font-bold text-brand transition-colors duration-200 group-hover:text-accent-dark">{titulo}</h3>
    <p class="mt-2 text-xs leading-relaxed text-neutral">{descripcion}</p>
  </div>
  <div class="mt-4 flex items-center gap-1 text-xs font-semibold text-brand transition-colors duration-200 group-hover:text-accent">
    <span>Ver exámenes</span>
    <Icon name="flecha" size={13} strokeWidth={2.4} class="transition-transform duration-200 group-hover:translate-x-1" />
  </div>
</Tag>
