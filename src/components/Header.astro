---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import EstadoApertura from './EstadoApertura.astro';
import { site, sedes, navPrincipal } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';

/*
  El botón de la cabecera entra directo a Saluto, el sistema donde viven los
  informes: es el acceso más usado del sitio y antes obligaba a pasar por una
  página intermedia. Los demás botones de «resultados» repartidos por el sitio
  siguen llevando a /soy-paciente/resultados, que explica qué se necesita y
  cómo se descarga el informe, para quien entra por primera vez.

  Como sale del sitio, se abre en otra pestaña y se avisa en el nombre
  accesible, que conserva la palabra visible del botón.
*/
const ETIQUETA_RESULTADOS = 'Resultados en Saluto, se abre en otra pestaña';

const ruta = Astro.url.pathname.replace(/\/+$/, '') || '/';
const esActivo = (href: string) => {
  const base = href.split('#')[0]!.replace(/\/+$/, '') || '/';
  return base === '/' ? ruta === '/' : ruta === base || ruta.startsWith(`${base}/`);
};

// Texto que se ve sin JavaScript. Sale del mismo horario que usa el indicador
// de apertura, así no puede quedar desactualizado cuando cambie el de la matriz.
const matriz = sedes[0]!;
const horarioResumen = `${matriz.horarios[0]!.dias} · ${matriz.horarios[0]!.horas}`;
---

<header
  id="cabecera"
  class="cabecera sticky top-0 z-50 bg-white shadow-[0_1px_0_var(--color-line)]"
>
  {/* Barra de utilidades (solo escritorio) */}
  <div class="hidden bg-brand text-xs font-medium text-white/80 menu:block">
    <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-2.5">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a
          href={`tel:${site.telefonoE164}`}
          class="flex items-center gap-2 text-white/80 transition-colors hover:text-white"
        >
          <Icon name="telefono" size={13} class="text-accent-light" />
          {site.telefono}
        </a>
        <span class="flex items-center gap-2">
          <Icon name="reloj" size={13} class="text-accent-light" />
          <EstadoApertura horario={matriz.horarioSemanal} respaldo={horarioResumen} oscuro />
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/sedes" class="flex items-center gap-2 text-white/80 transition-colors hover:text-white">
          <Icon name="pin" size={13} class="text-accent-light" />
          Ambato y Pelileo
        </a>
        <a
          href="/soy-profesional"
          class="text-white transition-colors hover:text-accent-light"
        >
          Portal profesional
        </a>
      </div>
    </div>
  </div>

  {/* Barra principal */}
  <div class="barra-principal container-page flex items-center gap-2.5 py-3.5 menu:gap-5">
    <a href="/" class="flex-none" aria-label={`${site.nombre} · inicio`}>
      <Logo box={54} bajada={false} compactoEnMovil />
    </a>

    <div class="flex-1"></div>

    {/* Navegación de escritorio */}
    <nav class="hidden items-center gap-4 menu:flex" aria-label="Navegación principal">
      {
        navPrincipal.map((item) =>
          item.hijos ? (
            <div class="submenu relative">
              <button
                type="button"
                class:list={[
                  'flex items-center gap-1.5 py-2 text-sm transition-colors hover:text-accent-dark',
                  esActivo(item.href) ? 'font-semibold text-brand' : 'font-medium text-black',
                ]}
                aria-expanded="false"
              >
                {item.label}
                <Icon name="flecha" size={13} strokeWidth={2.4} class="submenu-icono rotate-90 text-accent-dark transition-transform duration-200" />
              </button>
              <div
                class="submenu-panel invisible absolute top-full left-1/2 z-10 w-[320px] -translate-x-1/2 pt-3 opacity-0 transition-colors duration-150"
              >
                <ul class="overflow-hidden rounded-lg border border-line bg-white p-2 shadow-lg">
                  {/*
                    El título del apartado es un <button> que solo despliega la
                    lista, así que su propia página quedaría inalcanzable. Se
                    añade aquí como primera entrada.
                  */}
                  <li class="mb-1 border-b border-line pb-1">
                    <a
                      href={item.href}
                      aria-current={ruta === item.href ? 'page' : undefined}
                      class="block rounded-md px-4 py-2.5 transition-colors hover:bg-brand-soft/50"
                    >
                      <span class="flex items-center gap-1.5 text-sm font-bold text-brand">
                        Ver {item.label}
                        <Icon name="flecha" size={13} strokeWidth={2.4} class="text-accent-dark" />
                      </span>
                      {item.descripcion && (
                        <span class="mt-0.5 block text-xs leading-snug text-neutral">
                          {item.descripcion}
                        </span>
                      )}
                    </a>
                  </li>
                  {item.hijos!.map((hijo) => (
                    <li>
                      <a
                        href={hijo.href}
                        class="block rounded-md px-4 py-2.5 transition-colors hover:bg-brand-soft/50"
                      >
                        <span class="block text-sm font-bold text-brand">{hijo.label}</span>
                        {hijo.descripcion && (
                          <span class="mt-0.5 block text-xs leading-snug text-neutral">
                            {hijo.descripcion}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={esActivo(item.href) ? 'page' : undefined}
              class:list={[
                'py-2 text-sm transition-colors hover:text-accent-dark',
                esActivo(item.href) ? 'font-semibold text-brand' : 'font-medium text-black',
              ]}
            >
              {item.label}
            </a>
          ),
        )
      }
      {/* El acceso más usado del sitio: va más grande que el resto del menú y
          con un brillo que recorre el botón al pasar el cursor. */}
      <a
        href={site.sistema.url}
        target="_blank"
        rel="noopener"
        aria-label={ETIQUETA_RESULTADOS}
        class="boton-resultados ml-3 flex min-h-12 items-center gap-2.5 rounded-xl bg-accent-dark px-6 py-3 text-base font-bold text-white ring-2 ring-accent-light/70 shadow-[0_6px_20px_rgb(0_126_153/0.45)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-accent-deep hover:shadow-[0_12px_28px_rgb(0_126_153/0.55)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
      >
        <Icon name="documento" size={19} />
        Resultados
      </a>
    </nav>

    {/* Acciones móviles */}
    <div class="flex items-center gap-2.5 menu:hidden">
      <a
        href={site.sistema.url}
        target="_blank"
        rel="noopener"
        aria-label={ETIQUETA_RESULTADOS}
        class="boton-resultados flex min-h-11 items-center gap-2 rounded-xl bg-accent-dark px-4 py-2.5 text-sm font-bold text-white ring-2 ring-accent-light/70 shadow-[0_6px_20px_rgb(0_126_153/0.45)]"
      >
        <Icon name="documento" size={17} />
        Resultados
      </a>
      <button
        type="button"
        id="btn-menu"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        class="flex h-11 w-11 flex-none items-center justify-center rounded-xl border border-line-strong bg-white text-brand"
      >
        <Icon name="menu" size={20} strokeWidth={2.2} />
      </button>
    </div>
  </div>

  {/* Menú móvil */}
  <nav
    id="menu-movil"
    hidden
    aria-label="Navegación móvil"
    class="max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-line bg-white px-6 pt-2.5 pb-6 menu:hidden"
  >
    <div class="flex flex-col">
      {
        navPrincipal.map((item, i) =>
          item.hijos ? (
            <details class="group border-b border-line" open={esActivo(item.href)}>
              <summary
                class:list={[
                  'flex cursor-pointer list-none items-center justify-between py-3.5 text-base',
                  esActivo(item.href) ? 'font-semibold text-brand' : 'font-medium text-black',
                ]}
              >
                {item.label}
                <Icon
                  name="mas"
                  size={18}
                  class="text-accent-dark transition-transform duration-200 group-open:rotate-45"
                />
              </summary>
              <ul class="pb-2">
                {/* Mismo motivo que en escritorio: el <summary> no navega. */}
                <li>
                  <a
                    href={item.href}
                    aria-current={ruta === item.href ? 'page' : undefined}
                    class="flex items-center gap-1.5 py-2.5 pl-3 text-base font-semibold text-brand transition-colors hover:text-accent-dark"
                  >
                    Ver {item.label}
                    <Icon name="flecha" size={14} strokeWidth={2.4} class="text-accent-dark" />
                  </a>
                </li>
                {item.hijos!.map((hijo) => (
                  <li>
                    <a
                      href={hijo.href}
                      class="block py-2.5 pl-3 text-base font-medium text-neutral transition-colors hover:text-accent-dark"
                    >
                      {hijo.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              href={item.href}
              aria-current={esActivo(item.href) ? 'page' : undefined}
              class:list={[
                'py-3.5 text-base',
                i < navPrincipal.length - 1 && 'border-b border-line',
                esActivo(item.href) ? 'font-semibold text-brand' : 'font-medium text-black',
              ]}
            >
              {item.label}
            </a>
          ),
        )
      }
      <a
        href={whatsappLink('cita')}
        target="_blank"
        rel="noopener"
        class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-brand px-4 py-4 text-center text-base font-bold text-white"
      >
        <Icon name="whatsapp-marca" size={17} />
        Agendar cita por WhatsApp
      </a>
    </div>
  </nav>
</header>

<style>
  /*
    Reparto del ancho en teléfonos.

    El nombre de la marca tiene que verse siempre: es lo primero que identifica
    al laboratorio y esconderlo dejaba la cabecera con un emblema mudo. Pero el
    botón de resultados es el acceso más usado del sitio y tampoco puede
    encogerse hasta perder su texto.

    Medido a 360 px: el emblema, el botón y el menú suman ~232 px de los 328
    útiles. Para que al nombre le queden los ~96 px que necesita, por debajo de
    26rem (416 px) se recorta el margen lateral de la barra, su separación
    interna y el relleno del botón. Solo afecta a esta barra, no al resto de la
    página, que sigue con el margen de 1,5rem de `container-page`.
  */
  @media (max-width: 26rem) {
    .barra-principal {
      padding-inline: 1rem;
      gap: 0.5rem;
    }
    .barra-principal .boton-resultados {
      padding-inline: 0.75rem;
      gap: 0.375rem;
    }
  }

  /*
    Brillo que cruza el botón de resultados al pasar el cursor. Es un
    pseudoelemento con degradado que se desplaza de izquierda a derecha; sin
    cursor (móvil) no pasa nada y el botón sigue siendo un botón.
  */
  .boton-resultados {
    position: relative;
    overflow: hidden;
  }
  .boton-resultados::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 30%,
      rgb(255 255 255 / 0.28) 50%,
      transparent 70%
    );
    transform: translateX(-100%);
    transition: transform 0.6s ease;
    pointer-events: none;
  }
  .boton-resultados:hover::after {
    transform: translateX(100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .boton-resultados::after {
      display: none;
    }
  }

  /* La apertura la controla el script: solo un submenú abierto a la vez. */
  .submenu[data-abierto='true'] .submenu-panel {
    visibility: visible;
    opacity: 1;
  }

  .submenu[data-abierto='true'] .submenu-icono {
    transform: rotate(-90deg);
  }
</style>

<script>
  // Con las transiciones de página, este módulo se ejecuta una sola vez y la
  // cabecera se reemplaza en cada navegación: por eso los listeners de
  // elementos se vuelven a montar en `astro:page-load`, y los de `document`
  // se registran una sola vez y buscan los elementos al dispararse.

  const submenus = () => Array.from(document.querySelectorAll<HTMLElement>('.submenu'));

  const cerrarSubmenus = (excepto?: HTMLElement) => {
    for (const grupo of submenus()) {
      if (grupo === excepto) continue;
      grupo.dataset.abierto = 'false';
      grupo.querySelector('button')?.setAttribute('aria-expanded', 'false');
    }
  };

  const abrirSubmenu = (grupo: HTMLElement) => {
    cerrarSubmenus(grupo);
    grupo.dataset.abierto = 'true';
    grupo.querySelector('button')?.setAttribute('aria-expanded', 'true');
  };

  const cerrarMenuMovil = () => {
    const boton = document.getElementById('btn-menu');
    const menu = document.getElementById('menu-movil');
    if (!boton || !menu) return;
    menu.hidden = true;
    boton.setAttribute('aria-expanded', 'false');
    boton.setAttribute('aria-label', 'Abrir menú');
  };

  const initCabecera = () => {
    const cabecera = document.getElementById('cabecera');
    // `astro:page-load` también se dispara en la carga inicial: sin esta
    // guarda los listeners se montaban dos veces y el clic abría y cerraba
    // el menú en el mismo gesto.
    if (!cabecera || cabecera.dataset.iniciada === 'true') return;
    cabecera.dataset.iniciada = 'true';

    // ── Menú móvil ──────────────────────────────────────────────────
    const boton = document.getElementById('btn-menu');
    const menu = document.getElementById('menu-movil');

    if (boton && menu) {
      boton.addEventListener('click', () => {
        if (menu.hidden) {
          menu.hidden = false;
          boton.setAttribute('aria-expanded', 'true');
          boton.setAttribute('aria-label', 'Cerrar menú');
        } else {
          cerrarMenuMovil();
        }
      });

      menu.addEventListener('click', (evento) => {
        if ((evento.target as HTMLElement).closest('a')) cerrarMenuMovil();
      });
    }

    // ── Submenús de escritorio: solo uno abierto a la vez ────────────
    for (const grupo of submenus()) {
      const disparador = grupo.querySelector('button');
      if (!disparador) continue;

      grupo.dataset.abierto = 'false';

      grupo.addEventListener('pointerenter', (evento) => {
        if (evento.pointerType === 'touch') return;
        abrirSubmenu(grupo);
      });
      grupo.addEventListener('pointerleave', (evento) => {
        if (evento.pointerType === 'touch') return;
        cerrarSubmenus();
      });

      disparador.addEventListener('click', (evento) => {
        evento.preventDefault();
        grupo.dataset.abierto === 'true' ? cerrarSubmenus() : abrirSubmenu(grupo);
      });

      grupo.addEventListener('focusin', () => abrirSubmenu(grupo));
      grupo.addEventListener('focusout', (evento) => {
        if (!grupo.contains(evento.relatedTarget as Node)) cerrarSubmenus();
      });
    }

    // ── Sombra de la cabecera al hacer scroll ────────────────────────
    marcarScroll();
  };

  // ── Listeners globales: se registran una sola vez ──────────────────

  /*
    Umbrales con histéresis: la sombra aparece al pasar los 80px y no
    desaparece hasta bajar de 40px. Con un único umbral, cualquier
    micromovimiento alrededor de ese punto encendía y apagaba la sombra
    varias veces por segundo.
  */
  const ENTRA = 80;
  const SALE = 40;

  const marcarScroll = () => {
    const cabecera = document.getElementById('cabecera');
    if (!cabecera) return;

    const y = window.scrollY;
    const activa = cabecera.dataset.scroll === 'true';
    if (!activa && y > ENTRA) cabecera.dataset.scroll = 'true';
    else if (activa && y < SALE) cabecera.dataset.scroll = 'false';
  };

  let pendiente = false;
  window.addEventListener(
    'scroll',
    () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        marcarScroll();
        pendiente = false;
      });
    },
    { passive: true },
  );

  document.addEventListener('keydown', (evento) => {
    if (evento.key !== 'Escape') return;

    const abierto = submenus().find((g) => g.dataset.abierto === 'true');
    if (abierto) {
      cerrarSubmenus();
      abierto.querySelector('button')?.focus();
      return;
    }

    const menu = document.getElementById('menu-movil');
    if (menu && !menu.hidden) {
      cerrarMenuMovil();
      document.getElementById('btn-menu')?.focus();
    }
  });

  document.addEventListener('click', (evento) => {
    if (!(evento.target as HTMLElement).closest('.submenu')) cerrarSubmenus();
  });

  // Debe coincidir con --breakpoint-menu de global.css.
  window.matchMedia('(min-width: 75rem)').addEventListener('change', (evento) => {
    if (evento.matches) cerrarMenuMovil();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCabecera);
  } else {
    initCabecera();
  }
  document.addEventListener('astro:page-load', initCabecera);
</script>
