---
/**
 * Ficha de detalle de un examen, compartida por el catálogo público y el de
 * laboratorios asociados. Reproduce el orden en que el laboratorio entrega la
 * información: utilidad, condiciones clínicas, tiempo de entrega, tipo de
 * muestra y técnica.
 */
import Icon from './Icon.astro';
import Button from './Button.astro';
import ExamCard from './ExamCard.astro';
import { interpretarAyuno, esRemision, type Examen } from '@/lib/examenes';
import { whatsappExamen } from '@/lib/whatsapp';
import type { IconName } from '@/lib/iconos';

interface Props {
  examen: Examen;
  relacionados: Examen[];
  basePath: string;
  catalogoLabel: string;
  /** Muestra las especificaciones para bioquímicos. */
  tecnico?: boolean;
}

const { examen, relacionados, basePath, catalogoLabel, tecnico = false } = Astro.props;
const waHref = whatsappExamen(examen.nombre, examen.codigo);
const ayuno = interpretarAyuno(examen);
const remision = esRemision(examen);
const ficha = examen.tecnico;

const datosPrincipales: { icono: IconName; etiqueta: string; valor: string }[] = [
  { icono: 'maletin', etiqueta: 'Especialidad', valor: examen.especialidad },
  { icono: 'gota', etiqueta: 'Tipo de muestra', valor: examen.tipoMuestra },
  { icono: 'reloj', etiqueta: 'Tiempo de entrega', valor: examen.tiempoEntrega },
  { icono: 'microscopio', etiqueta: 'Técnica', valor: examen.tecnica },
];

const especificaciones: { icono: IconName; etiqueta: string; valor?: string }[] = [
  { icono: 'microscopio', etiqueta: 'Equipo', valor: ficha?.equipo },
  { icono: 'pipeta', etiqueta: 'Volumen mínimo', valor: ficha?.volumenMinimo },
  { icono: 'nieve', etiqueta: 'Conservación', valor: ficha?.conservacion },
  { icono: 'termometro', etiqueta: 'Transporte', valor: ficha?.transporte },
  { icono: 'calendario', etiqueta: 'Días de proceso', valor: ficha?.diasProceso },
  { icono: 'matraz', etiqueta: 'Unidades de reporte', valor: ficha?.unidades },
  { icono: 'codigo-barras', etiqueta: 'Código LOINC', valor: ficha?.loinc },
];

const especificacionesVisibles = especificaciones.filter((e) => e.valor);
---

<!-- Cabecera del examen -->
<section class="bg-brand">
  <div class="container-page py-10 lg:py-14">
    <nav aria-label="Ruta de navegación" class="mb-6">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[12.5px] text-white/60">
        <li><a href="/" class="transition-colors hover:text-accent-light">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={basePath} class="transition-colors hover:text-accent-light">{catalogoLabel}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-white/85" aria-current="page">{examen.nombre}</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_320px] lg:items-start lg:gap-12">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span
            class="rounded-lg bg-white/12 px-2.5 py-1.5 text-[11px] font-bold tracking-[0.4px] text-accent-light uppercase"
          >
            {examen.especialidad}
          </span>
          <span class="font-mono text-[12.5px] font-semibold text-white/60">{examen.codigo}</span>
          {
            remision && (
              <span class="rounded-lg border border-white/25 px-2.5 py-1.5 text-[11px] font-bold tracking-[0.4px] text-white/75 uppercase">
                Remisión
              </span>
            )
          }
        </div>

        <h1 class="mt-4 text-h1 font-bold text-white">{examen.nombre}</h1>

        {
          examen.sinonimos && examen.sinonimos.length > 0 && (
            <p class="mt-3 text-[13.5px] text-white/60">
              También conocido como: {examen.sinonimos.join(' · ')}
            </p>
          )
        }
      </div>

      <!-- Tarjeta de acción -->
      <aside class="rounded-3xl bg-white p-6 shadow-[0_16px_40px_rgb(0_0_0/0.18)]">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent-soft text-accent-dark">
          <Icon name="calendario" size={21} />
        </span>
        <h2 class="mt-4 text-[18px] leading-snug font-bold text-brand">
          Agende este examen o consulte su valor
        </h2>
        <p class="mt-2.5 text-[13.5px] leading-relaxed text-neutral">
          Le confirmamos disponibilidad, precio vigente y convenios por WhatsApp. También puede
          acudir sin cita en horario de atención.
        </p>
        <div class="mt-5 flex flex-col gap-2.5">
          <Button href={waHref} icon="whatsapp-marca" full>Consultar por WhatsApp</Button>
          {
            examen.ficha ? (
              <Button href={examen.ficha} variant="secondary" size="sm" icon="documento" full>
                Descargar ficha en PDF
              </Button>
            ) : (
              <span class="flex items-center justify-center gap-2 rounded-2xl border-[1.5px] border-dashed border-line-strong px-5 py-3 text-[13px] font-semibold text-neutral">
                <Icon name="documento" size={16} />
                Ficha en PDF próximamente
              </span>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- Datos principales -->
<section class="bg-surface py-10">
  <div class="container-page grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      datosPrincipales.map((dato) => (
        <div class="flex items-start gap-3.5 rounded-2xl bg-white p-5 shadow-card">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-accent-soft text-accent-dark">
            <Icon name={dato.icono} size={19} />
          </span>
          <div>
            <span class="block text-[11.5px] font-bold tracking-[0.6px] text-neutral uppercase">
              {dato.etiqueta}
            </span>
            <span class="mt-1 block text-sm leading-snug font-semibold text-brand">
              {dato.valor}
            </span>
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Detalle -->
<section class="bg-white py-section">
  <div class="container-page grid grid-cols-1 gap-10 lg:grid-cols-[1fr_360px] lg:gap-14">
    <div>
      <h2 class="text-h2 font-bold text-brand">Utilidad</h2>
      <p class="mt-4 text-base leading-relaxed text-neutral">{examen.utilidad}</p>

      {
        tecnico && especificacionesVisibles.length > 0 && (
          <>
            <h2 class="mt-10 text-h2 font-bold text-brand">Especificaciones de laboratorio</h2>
            <p class="mt-3 text-[14px] leading-relaxed text-neutral">
              Datos preanalíticos y de procesamiento para el bioquímico responsable de la muestra.
            </p>
            <dl class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {especificacionesVisibles.map((dato) => (
                <div class="flex items-start gap-3 rounded-2xl border border-line bg-surface p-4">
                  <span class="mt-0.5 flex h-9 w-9 flex-none items-center justify-center rounded-xl bg-white text-brand">
                    <Icon name={dato.icono} size={19} />
                  </span>
                  <div>
                    <dt class="text-[11.5px] font-bold tracking-[0.6px] text-neutral uppercase">
                      {dato.etiqueta}
                    </dt>
                    <dd
                      class:list={[
                        'mt-1 text-[14px] leading-snug font-semibold text-brand',
                        dato.etiqueta === 'Código LOINC' && 'font-mono tracking-wide',
                      ]}
                    >
                      {dato.valor}
                    </dd>
                  </div>
                </div>
              ))}
            </dl>
          </>
        )
      }

      {
        tecnico && ficha?.criteriosRechazo && ficha.criteriosRechazo.length > 0 && (
          <>
            <h2 class="mt-10 text-h2 font-bold text-brand">Criterios de rechazo</h2>
            <p class="mt-3 text-[14px] leading-relaxed text-neutral">
              La muestra se rechaza y se solicita una nueva toma si se presenta cualquiera de estas
              condiciones. El rechazo se notifica al laboratorio remitente el mismo día.
            </p>
            <ul class="mt-4 flex flex-col gap-2.5">
              {ficha.criteriosRechazo.map((item) => (
                <li class="flex items-start gap-3 rounded-2xl border border-alert/25 bg-alert-soft/40 px-4 py-3.5 text-[14.5px] leading-relaxed text-neutral">
                  <Icon name="prohibido" size={18} class="mt-0.5 flex-none text-alert" />
                  {item}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    <!-- Condiciones clínicas -->
    <aside class="lg:sticky lg:top-28">
      <div
        class:list={[
          'rounded-3xl border p-6',
          ayuno.requiere ? 'border-alert/25 bg-alert-soft/50' : 'border-line bg-surface',
        ]}
      >
        <div class="flex items-center gap-3">
          <span
            class:list={[
              'flex h-10 w-10 flex-none items-center justify-center rounded-xl',
              ayuno.requiere ? 'bg-alert text-white' : 'bg-accent-soft text-accent-dark',
            ]}
          >
            <Icon name={ayuno.requiere ? 'alerta' : 'check'} size={20} />
          </span>
          <div>
            <h2 class="text-[19px] leading-tight font-bold text-brand">Condiciones clínicas</h2>
            <span class="text-[12.5px] font-semibold text-neutral">{ayuno.texto}</span>
          </div>
        </div>

        <p class="mt-5 text-[14.5px] leading-relaxed text-neutral">{examen.condicionesClinicas}</p>

        <div class="mt-6 border-t border-line pt-5">
          {
            ayuno.requiere && (
              <a
                href="/soy-paciente#ayuno"
                class="flex items-center gap-2 text-[13px] font-semibold text-accent transition-colors hover:text-brand"
              >
                <Icon name="reloj" size={16} />
                Calcule su hora exacta de ayuno
              </a>
            )
          }
          <Button href={waHref} icon="whatsapp-marca" size="sm" full class="mt-4">
            Consultar por WhatsApp
          </Button>
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- Relacionados -->
{
  relacionados.length > 0 && (
    <section class="bg-surface py-section">
      <div class="container-page">
        <h2 class="text-h2 font-bold text-brand">Otros exámenes de la misma especialidad</h2>
        <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {relacionados.map((otro) => (
            <ExamCard examen={otro} basePath={basePath} tecnico={tecnico} />
          ))}
        </div>
      </div>
    </section>
  )
}
