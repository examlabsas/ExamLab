---
/**
 * Ficha de detalle de un examen, compartida por el catálogo público y el de
 * laboratorios asociados. Reproduce el orden en que el laboratorio entrega la
 * información: utilidad, condiciones clínicas, tiempo de entrega, tipo de
 * muestra y técnica.
 */
import Icon from './Icon.astro';
import Button from './Button.astro';
import ExamCard from './ExamCard.astro';
import FondoGotas from './FondoGotas.astro';
import BotonLista from './BotonLista.astro';
import AyunoFicha from './AyunoFicha.astro';
import ProgresoLectura from './ProgresoLectura.astro';
import PulsoEcg from './PulsoEcg.astro';
import {
  interpretarAyuno,
  esRemision,
  bloqueDePreparacion,
  tieneDato,
  etiquetaEntrega,
  etiquetaMuestra,
  fraseEntrega,
  fraseMuestra,
  fraseAyuno,
  type Examen,
} from '@/lib/examenes';
import { whatsappExamen } from '@/lib/whatsapp';
import type { IconName } from '@/lib/iconos';

interface Props {
  examen: Examen;
  relacionados: Examen[];
  basePath: string;
  catalogoLabel: string;
  /** Muestra las especificaciones para bioquímicos. */
  tecnico?: boolean;
}

const { examen, relacionados, basePath, catalogoLabel, tecnico = false } = Astro.props;
const waHref = whatsappExamen(examen.nombre, examen.codigo);
const ayuno = interpretarAyuno(examen);
const remision = esRemision(examen);
// Se deduce del tipo de muestra; no hay que etiquetar examen por examen.
const preparacion = bloqueDePreparacion(examen);
const ficha = examen.tecnico;

// La técnica es un dato para bioquímicos: al paciente solo se le muestra
// cuando existe de verdad, nunca como «Consultar».
const datosPrincipales: { icono: IconName; etiqueta: string; valor: string }[] = [
  { icono: 'maletin', etiqueta: 'Especialidad', valor: examen.especialidad },
  { icono: 'gota', etiqueta: 'Tipo de muestra', valor: etiquetaMuestra(examen) },
  { icono: 'reloj', etiqueta: 'Tiempo de entrega', valor: etiquetaEntrega(examen) },
  ...(tieneDato(examen.tecnica)
    ? [{ icono: 'microscopio' as IconName, etiqueta: 'Técnica', valor: examen.tecnica }]
    : []),
];

const especificaciones: { icono: IconName; etiqueta: string; valor?: string }[] = [
  { icono: 'microscopio', etiqueta: 'Equipo', valor: ficha?.equipo },
  { icono: 'pipeta', etiqueta: 'Volumen mínimo', valor: ficha?.volumenMinimo },
  { icono: 'nieve', etiqueta: 'Conservación', valor: ficha?.conservacion },
  { icono: 'termometro', etiqueta: 'Transporte', valor: ficha?.transporte },
  { icono: 'calendario', etiqueta: 'Días de proceso', valor: ficha?.diasProceso },
  { icono: 'matraz', etiqueta: 'Unidades de reporte', valor: ficha?.unidades },
  { icono: 'codigo-barras', etiqueta: 'Código LOINC', valor: ficha?.loinc },
];

const especificacionesVisibles = especificaciones.filter((e) => e.valor);

/** La utilidad puede venir en varios párrafos, separados por una línea en blanco. */
const parrafosUtilidad = examen.utilidad.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);

/** Las determinaciones de un perfil vienen separadas por « · » desde el importador. */
const partesIncluye = examen.incluye ? examen.incluye.split(' · ').filter(Boolean) : [];
---

<ProgresoLectura />

{/* Cabecera del examen */}
<section class="relative overflow-hidden bg-brand">
  <FondoGotas />
  <PulsoEcg class="h-20 text-white opacity-25" />
  <div class="container-page relative py-10 lg:py-14">
    <nav aria-label="Ruta de navegación" class="mb-6">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/75">
        {/* Relleno vertical con margen negativo: área de toque de 24px sin
             alterar la línea de la miga de pan. */}
        <li>
          <a href="/" class="-my-1.5 inline-block py-1.5 transition-colors hover:text-accent-light">
            Inicio
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a
            href={basePath}
            class="-my-1.5 inline-block py-1.5 transition-colors hover:text-accent-light"
          >
            {catalogoLabel}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-white/85" aria-current="page">{examen.nombre}</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_320px] lg:items-start lg:gap-12">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span
            class="rounded-md bg-brand-dark px-2.5 py-1.5 text-[11px] font-bold tracking-[0.4px] text-accent-light uppercase"
          >
            {examen.especialidad}
          </span>
          {/* El código real está en el sistema del laboratorio: mientras no llegue, no se deja el hueco. */}
          {examen.codigo && (
            <span class="font-mono text-xs font-semibold text-white/75">{examen.codigo}</span>
          )}
          {
            remision && (
              <span class="rounded-md border border-white/25 px-2.5 py-1.5 text-[11px] font-bold tracking-[0.4px] text-white/75 uppercase">
                Remisión
              </span>
            )
          }
        </div>

        <h1 style={`view-transition-name: examen-${examen.slug}`} class="mt-4 text-h1 font-bold text-white">
          {examen.nombre}
        </h1>

        {
          examen.resumen && (
            <p class="mt-4 max-w-[52ch] text-lead leading-relaxed text-white/85">
              {examen.resumen}
            </p>
          )
        }

        {
          examen.sinonimos && examen.sinonimos.length > 0 && (
            <p class="mt-4 text-sm text-white/75">
              También conocido como: {examen.sinonimos.join(' · ')}
            </p>
          )
        }
      </div>

      {/* Tarjeta de acción */}
      <aside class="rounded-xl bg-white p-6 shadow-[0_16px_40px_rgb(0_0_0/0.18)]">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent-dark">
          <Icon name="calendario" size={21} />
        </span>
        <h2 class="mt-4 text-lg leading-snug font-bold text-brand">
          ¿Quiere agendar este examen o saber su valor?
        </h2>
        <p class="mt-2.5 text-sm leading-relaxed text-neutral">
          Escríbanos por WhatsApp y le confirmamos el precio, la disponibilidad y si aplica algún
          convenio. Si prefiere, también puede venir sin cita en horario de atención.
        </p>
        <div class="mt-5 flex flex-col gap-2.5">
          <Button href={waHref} icon="whatsapp-marca" full>Consultar por WhatsApp</Button>
          {/* Para quien trae una orden con varios exámenes: los junta y los
              manda en un solo mensaje. */}
          <BotonLista examen={examen} variante="ancho" />
          {/*
            El botón solo existe si hay PDF. Antes, cuando faltaba, se pintaba
            un «Ficha en PDF próximamente»: hoy ninguno de los 559 exámenes
            tiene ficha, así que esa promesa sin fecha salía en las 559 fichas.
            Es el mismo caso del manual en PDF que el Dr. Silva pidió quitar
            porque el archivo no existía.
          */}
          {examen.ficha && (
            <Button href={examen.ficha} variant="secondary" size="sm" icon="documento" full>
              Descargar ficha en PDF
            </Button>
          )}
        </div>
      </aside>
    </div>
  </div>
</section>

{/* Datos principales */}
<section class="bg-surface py-10">
  <div class="reveal-stagger container-page grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      datosPrincipales.map((dato) => (
        <div class="flex items-start gap-3.5 rounded-xl bg-white p-5 border border-line">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-accent-soft text-accent-dark">
            <Icon name={dato.icono} size={19} dibujo />
          </span>
          <div>
            <span class="block text-[11px] font-bold tracking-[0.6px] text-neutral uppercase">
              {dato.etiqueta}
            </span>
            <span class="mt-1 block text-sm leading-snug font-semibold text-brand">
              {dato.valor}
            </span>
          </div>
        </div>
      ))
    }
  </div>
</section>

{/* Detalle */}
<section class="bg-white py-section">
  <div class="container-page grid grid-cols-1 gap-10 lg:grid-cols-[1fr_360px] lg:gap-14">
    <div>
      <h2 class="text-h2 font-bold text-brand">Para qué sirve</h2>
      {parrafosUtilidad.map((parrafo) => (
        <p class="mt-4 text-base leading-relaxed text-neutral">{parrafo}</p>
      ))}

      {
        partesIncluye.length > 0 && (
          <>
            <h2 class="mt-10 text-h2 font-bold text-brand">Qué incluye</h2>
            <ul class="mt-4 flex flex-col gap-2">
              {partesIncluye.map((parte) => (
                <li class="flex items-start gap-2.5 text-base leading-relaxed text-neutral">
                  <Icon name="check" size={16} strokeWidth={2.2} class="mt-1.5 flex-none text-accent-dark" />
                  {parte}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {/*
        Preguntas frecuentes armadas con los datos que ya tiene la ficha. No es
        relleno: son las tres cosas que el paciente pregunta en recepción, y las
        respuestas salen del mismo dato que muestran los recuadros de arriba.
      */}
      <h2 class="mt-10 text-h2 font-bold text-brand">Preguntas frecuentes</h2>
      <div class="mt-4 flex flex-col gap-3">
        <details class="group rounded-lg border border-line bg-white open:border-accent-dark">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 p-5 text-base font-bold text-brand">
            ¿Tengo que venir en ayunas?
            <Icon name="mas" size={18} class="flex-none text-accent-dark transition-transform duration-200 group-open:rotate-45" />
          </summary>
          <p class="px-5 pb-5 text-base leading-relaxed text-neutral">{fraseAyuno(examen)}</p>
        </details>

        <details class="group rounded-lg border border-line bg-white open:border-accent-dark">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 p-5 text-base font-bold text-brand">
            ¿Cuándo tengo el resultado?
            <Icon name="mas" size={18} class="flex-none text-accent-dark transition-transform duration-200 group-open:rotate-45" />
          </summary>
          <p class="px-5 pb-5 text-base leading-relaxed text-neutral">{fraseEntrega(examen)}</p>
        </details>

        <details class="group rounded-lg border border-line bg-white open:border-accent-dark">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 p-5 text-base font-bold text-brand">
            ¿Qué muestra se toma?
            <Icon name="mas" size={18} class="flex-none text-accent-dark transition-transform duration-200 group-open:rotate-45" />
          </summary>
          <p class="px-5 pb-5 text-base leading-relaxed text-neutral">{fraseMuestra(examen)}</p>
        </details>
      </div>

      {
        tecnico && especificacionesVisibles.length > 0 && (
          <>
            <h2 class="mt-10 text-h2 font-bold text-brand">Especificaciones de laboratorio</h2>
            <p class="mt-3 text-sm leading-relaxed text-neutral">
              Datos preanalíticos y de procesamiento para el bioquímico responsable de la muestra.
            </p>
            <dl class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {especificacionesVisibles.map((dato) => (
                <div class="flex items-start gap-3 rounded-xl border border-line bg-surface p-4">
                  <span class="mt-0.5 flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-white text-brand">
                    <Icon name={dato.icono} size={19} />
                  </span>
                  <div>
                    <dt class="text-[11px] font-bold tracking-[0.6px] text-neutral uppercase">
                      {dato.etiqueta}
                    </dt>
                    <dd
                      class:list={[
                        'mt-1 text-sm leading-snug font-semibold text-brand',
                        dato.etiqueta === 'Código LOINC' && 'font-mono tracking-wide',
                      ]}
                    >
                      {dato.valor}
                    </dd>
                  </div>
                </div>
              ))}
            </dl>
          </>
        )
      }

      {
        tecnico && ficha?.criteriosRechazo && ficha.criteriosRechazo.length > 0 && (
          <>
            <h2 class="mt-10 text-h2 font-bold text-brand">Criterios de rechazo</h2>
            <p class="mt-3 text-sm leading-relaxed text-neutral">
              La muestra se rechaza y se solicita una nueva toma si se presenta cualquiera de estas
              condiciones. El rechazo se notifica al laboratorio remitente el mismo día.
            </p>
            <ul class="mt-4 flex flex-col gap-2.5">
              {ficha.criteriosRechazo.map((item) => (
                <li class="flex items-start gap-3 rounded-xl border border-alert/25 bg-alert-soft/40 px-4 py-3.5 text-sm leading-relaxed text-neutral">
                  <Icon name="prohibido" size={18} class="mt-0.5 flex-none text-alert" />
                  {item}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    {/* Condiciones clínicas */}
    <aside class="lg:sticky lg:top-28">
      <div
        class:list={[
          'rounded-xl border p-6',
          ayuno.requiere ? 'border-alert/25 bg-alert-soft/50' : 'border-line bg-surface',
        ]}
      >
        <div class="flex items-center gap-3">
          <span
            class:list={[
              'flex h-10 w-10 flex-none items-center justify-center rounded-lg',
              ayuno.requiere ? 'bg-alert text-white' : 'bg-accent-soft text-accent-dark',
            ]}
          >
            <Icon name={ayuno.requiere ? 'alerta' : 'check'} size={20} />
          </span>
          <div>
            <h2 class="text-lg leading-tight font-bold text-brand">Condiciones clínicas</h2>
            <span class="text-xs font-semibold text-neutral">{ayuno.texto}</span>
          </div>
        </div>

        <p class="mt-5 text-sm leading-relaxed text-neutral">{examen.condicionesClinicas}</p>

        {/* La pregunta se responde aquí mismo, donde se acaba de leer el ayuno. */}
        <AyunoFicha examen={examen} />

        <div class="mt-6 border-t border-line pt-5">
          <div class="flex flex-col gap-3">
            {
              preparacion && (
                <a
                  href={`/preparacion#${preparacion.id}`}
                  class="flex items-center gap-2 text-xs font-semibold text-accent-dark transition-colors hover:text-brand"
                >
                  <Icon name={preparacion.icono} size={16} />
                  Cómo prepararse: {preparacion.titulo.toLowerCase()}
                </a>
              )
            }
          </div>
          <Button href={waHref} icon="whatsapp-marca" size="sm" full class="mt-4">
            Consultar por WhatsApp
          </Button>
        </div>
      </div>
    </aside>
  </div>
</section>

{/* Relacionados */}
{
  relacionados.length > 0 && (
    <section class="bg-surface py-section">
      <div class="container-page">
        <h2 class="text-h2 font-bold text-brand">Otros exámenes de la misma especialidad</h2>
        <div class="reveal-stagger mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {relacionados.map((otro) => (
            <ExamCard examen={otro} basePath={basePath} tecnico={tecnico} />
          ))}
        </div>
      </div>
    </section>
  )
}
