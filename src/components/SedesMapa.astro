---
/**
 * Selector de sedes con mapa.
 *
 * Reemplaza a la cuadrícula de tarjetas de la portada. A la izquierda las
 * cuatro sedes, cada una con su estado real de apertura; a la derecha el mapa
 * de la seleccionada y sus datos. Elegir una no recarga nada: se cambia el
 * `src` del iframe y se reescriben los textos.
 *
 * Los datos salen todos de `sedes` (site.ts) y las coordenadas son las exactas
 * de los enlaces de Google Maps que entregó el laboratorio, así que el pin cae
 * en la puerta y no en la manzana.
 *
 * Sin JavaScript se ve la primera sede con su mapa y los enlaces a las páginas
 * de cada sede siguen funcionando: no se pierde información.
 */
import Icon from './Icon.astro';
import EstadoApertura from './EstadoApertura.astro';
import { sedes, mapaEmbed, mapaEnlace, site } from '@/lib/site';
import { whatsappSede } from '@/lib/whatsapp';

const inicial = sedes[0]!;

/** Todo lo que el script necesita para repintar el panel al cambiar de sede. */
const datos = sedes.map((sede) => ({
  slug: sede.slug,
  nombre: sede.nombre,
  direccion: sede.direccion,
  referencia: sede.referencia ?? '',
  ciudad: sede.ciudad,
  telefono: sede.telefono,
  telefonoE164: sede.telefonoE164,
  horarios: sede.horarios,
  mapa: mapaEmbed(sede, 17),
  comoLlegar: mapaEnlace(sede),
  whatsapp: whatsappSede(sede.nombre),
  pagina: `/sedes/${sede.slug}`,
}));
---

<section id="sedes" class="scroll-mt-24 bg-surface py-section">
  <div class="container-page">
    <div class="reveal">
      <span class="block text-xs font-bold tracking-[1.8px] text-accent-dark uppercase">
        Puntos de atención
      </span>
      <h2 class="mt-3 text-h2 font-bold text-brand">
        {sedes.length} sedes en {site.ciudad} y Pelileo
      </h2>
      <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-neutral">
        Elija la que le quede más cerca: verá su ubicación en el mapa, su horario y si está
        atendiendo en este momento.
      </p>
    </div>

    <div class="mt-9 grid grid-cols-1 gap-6 lg:grid-cols-[22rem_1fr] lg:gap-8">
      <!-- Lista de sedes -->
      <div
        class="reveal-stagger flex flex-col gap-2.5"
        role="tablist"
        aria-label="Seleccione una sede"
        data-sedes-lista
      >
        {
          sedes.map((sede, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${sede.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="panel-sede"
              tabindex={i === 0 ? 0 : -1}
              data-sede={sede.slug}
              class="sede-opcion group relative w-full overflow-hidden rounded-xl border border-line bg-white p-5 text-left transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-accent-dark motion-reduce:hover:translate-y-0"
            >
              {/* Filete lateral que crece cuando la sede queda seleccionada. */}
              <span
                class="sede-filete absolute inset-y-0 left-0 w-1 origin-top scale-y-0 bg-accent-dark transition-transform duration-300 ease-out"
                aria-hidden="true"
              />
              <span class="flex flex-wrap items-center gap-2">
                <span class="sede-pin flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-accent-soft text-accent-dark transition-colors duration-200">
                  <Icon name="pin" size={19} />
                </span>
                <span class="text-base font-bold text-brand">{sede.nombre}</span>
                {sede.etiqueta === 'Matriz' && (
                  <span class="rounded-md bg-brand px-2 py-0.5 text-[10px] font-bold tracking-[0.4px] text-white uppercase">
                    Matriz
                  </span>
                )}
              </span>
              <span class="mt-2 block text-sm leading-snug text-neutral">{sede.direccion}</span>
              <EstadoApertura
                horario={sede.horarioSemanal}
                respaldo={sede.horarios[0]!.horas}
                class="mt-2.5 text-xs font-semibold text-brand"
              />
            </button>
          ))
        }
      </div>

      <!-- Mapa y datos de la sede activa -->
      <div
        id="panel-sede"
        role="tabpanel"
        aria-labelledby={`tab-${inicial.slug}`}
        class="flex flex-col overflow-hidden rounded-xl border border-line bg-white"
      >
        <div class="relative">
          <iframe
            data-mapa
            src={mapaEmbed(inicial, 17)}
            title={`Mapa de ${site.nombre} ${inicial.nombre}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-[clamp(16rem,30vw,24rem)] w-full border-0 transition-opacity duration-300"
            allowfullscreen></iframe>
        </div>

        <div class="flex flex-col gap-4 p-6 lg:flex-row lg:items-start lg:justify-between lg:gap-8">
          <div>
            <h3 class="text-lg font-bold text-brand" data-panel-nombre>{inicial.nombre}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-neutral" data-panel-direccion>
              {inicial.direccion}{inicial.referencia && ` · ${inicial.referencia}`}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-neutral" data-panel-horario>
              {inicial.horarios.map((h) => `${h.dias} ${h.horas}`).join(' · ')}
            </p>
            <a
              href={`tel:${inicial.telefonoE164}`}
              data-panel-telefono
              class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-brand transition-colors hover:text-accent-dark"
            >
              <Icon name="telefono" size={16} class="text-accent-dark" />
              <span data-panel-telefono-texto>{inicial.telefono}</span>
            </a>
          </div>

          <div class="flex flex-none flex-col gap-2.5 sm:flex-row lg:flex-col">
            <a
              href={whatsappSede(inicial.nombre)}
              data-panel-whatsapp
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-whatsapp-boton px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-whatsapp-dark"
            >
              <Icon name="whatsapp-marca" size={16} />
              Agendar aquí
            </a>
            <a
              href={mapaEnlace(inicial)}
              data-panel-comollegar
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border-[1.5px] border-line-strong bg-white px-4 py-3 text-sm font-bold text-brand transition-colors hover:border-accent-dark"
            >
              <Icon name="pin" size={16} class="text-accent-dark" />
              Cómo llegar
            </a>
            <a
              href={`/sedes/${inicial.slug}`}
              data-panel-pagina
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-4 py-3 text-sm font-bold text-accent-dark transition-colors hover:text-brand"
            >
              Ver la sede
              <Icon name="flecha" size={15} strokeWidth={2.4} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Estado seleccionado: filete lateral desplegado y pin invertido. */
  .sede-opcion[aria-selected='true'] {
    border-color: var(--color-accent-dark);
    box-shadow: 0 10px 28px rgb(0 90 140 / 0.1);
  }
  .sede-opcion[aria-selected='true'] .sede-filete {
    transform: scaleY(1);
  }
  .sede-opcion[aria-selected='true'] .sede-pin {
    background: var(--color-accent-dark);
    color: #fff;
  }

  /* El pin de la sede activa late, como el punto de «abierto ahora». */
  .sede-opcion[aria-selected='true'] .sede-pin::after {
    content: '';
    position: absolute;
    left: 1.25rem;
    height: 2.25rem;
    width: 2.25rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-accent-dark);
    animation: sede-latido 2.6s ease-out infinite;
    pointer-events: none;
  }

  @keyframes sede-latido {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    45% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sede-opcion[aria-selected='true'] .sede-pin::after {
      animation: none;
    }
    .sede-filete {
      transition: none;
    }
  }
</style>

<script is:inline define:vars={{ datos }}>
  window.__examlabSedes = datos;
</script>

<script>
  type DatoSede = {
    slug: string;
    nombre: string;
    direccion: string;
    referencia: string;
    ciudad: string;
    telefono: string;
    telefonoE164: string;
    horarios: { dias: string; horas: string }[];
    mapa: string;
    comoLlegar: string;
    whatsapp: string;
    pagina: string;
  };

  const initSedesMapa = () => {
    const lista = document.querySelector<HTMLElement>('[data-sedes-lista]');
    if (!lista || lista.dataset.iniciado === 'true') return;
    lista.dataset.iniciado = 'true';

    const datos = (window as unknown as { __examlabSedes?: DatoSede[] }).__examlabSedes;
    if (!datos) return;

    const tabs = [...lista.querySelectorAll<HTMLButtonElement>('[data-sede]')];
    const mapa = document.querySelector<HTMLIFrameElement>('[data-mapa]');
    const panel = document.getElementById('panel-sede');
    const texto = (sel: string) => document.querySelector<HTMLElement>(sel);
    const enlace = (sel: string) => document.querySelector<HTMLAnchorElement>(sel);

    const seleccionar = (slug: string, moverFoco = false) => {
      const sede = datos.find((d) => d.slug === slug);
      if (!sede) return;

      for (const tab of tabs) {
        const activa = tab.dataset.sede === slug;
        tab.setAttribute('aria-selected', String(activa));
        tab.tabIndex = activa ? 0 : -1;
        if (activa && moverFoco) tab.focus();
      }

      // El mapa se desvanece mientras carga el nuevo: el salto en seco entre
      // dos mapas distintos se lee como un parpadeo de error.
      if (mapa && mapa.src !== sede.mapa) {
        mapa.style.opacity = '0.35';
        mapa.src = sede.mapa;
        mapa.title = `Mapa de ${sede.nombre}`;
        mapa.addEventListener('load', () => (mapa.style.opacity = '1'), { once: true });
      }

      const nombre = texto('[data-panel-nombre]');
      if (nombre) nombre.textContent = sede.nombre;

      const direccion = texto('[data-panel-direccion]');
      if (direccion) {
        direccion.textContent = sede.referencia
          ? `${sede.direccion} · ${sede.referencia}`
          : sede.direccion;
      }

      const horario = texto('[data-panel-horario]');
      if (horario) {
        horario.textContent = sede.horarios.map((h) => `${h.dias} ${h.horas}`).join(' · ');
      }

      const telefono = enlace('[data-panel-telefono]');
      const telefonoTexto = texto('[data-panel-telefono-texto]');
      if (telefono) telefono.href = `tel:${sede.telefonoE164}`;
      if (telefonoTexto) telefonoTexto.textContent = sede.telefono;

      const whatsapp = enlace('[data-panel-whatsapp]');
      if (whatsapp) whatsapp.href = sede.whatsapp;

      const comoLlegar = enlace('[data-panel-comollegar]');
      if (comoLlegar) comoLlegar.href = sede.comoLlegar;

      const pagina = enlace('[data-panel-pagina]');
      if (pagina) pagina.href = sede.pagina;

      if (panel) panel.setAttribute('aria-labelledby', `tab-${sede.slug}`);
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => seleccionar(tab.dataset.sede ?? ''));
    }

    // Flechas para moverse entre sedes, como espera un `tablist`.
    lista.addEventListener('keydown', (evento) => {
      const teclas = ['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft', 'Home', 'End'];
      if (!teclas.includes(evento.key)) return;
      evento.preventDefault();

      const actual = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const ultimo = tabs.length - 1;
      let siguiente = actual;
      if (evento.key === 'ArrowDown' || evento.key === 'ArrowRight') siguiente = actual >= ultimo ? 0 : actual + 1;
      if (evento.key === 'ArrowUp' || evento.key === 'ArrowLeft') siguiente = actual <= 0 ? ultimo : actual - 1;
      if (evento.key === 'Home') siguiente = 0;
      if (evento.key === 'End') siguiente = ultimo;

      seleccionar(tabs[siguiente]?.dataset.sede ?? '', true);
    });
  };

  initSedesMapa();
  document.addEventListener('astro:page-load', initSedesMapa);
</script>
