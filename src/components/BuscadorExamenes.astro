---
/**
 * Buscador de exámenes que lleva directo al catálogo.
 *
 * Es un formulario GET normal: funciona sin JavaScript y aprovecha que las
 * páginas de catálogo ya leen el parámetro `q` al cargar.
 *
 * `accion` permite apuntar al catálogo público o al de laboratorios asociados.
 */
import Icon from './Icon.astro';

interface Props {
  /** Ruta del catálogo al que se envía la búsqueda. */
  accion?: string;
  placeholder?: string;
  /** Texto del botón. */
  boton?: string;
  /** `true` sobre fondo azul (cabeceras de página interna). */
  oscuro?: boolean;
  /** Identificador único del campo, por si hay dos buscadores en una página. */
  id?: string;
  /**
   * Ejemplos que el campo «escribe» solo, uno tras otro, mientras está vacío
   * y sin foco. Enseña qué se puede buscar sin ocupar espacio. Con
   * prefers-reduced-motion se muestra el `placeholder` fijo.
   */
  ejemplos?: string[];
  class?: string;
}

const {
  accion = '/catalogo',
  placeholder = 'Busque su examen: biometría, TSH, urocultivo…',
  boton = 'Buscar',
  oscuro = false,
  id = 'buscar-examenes',
  ejemplos,
  class: className,
} = Astro.props;
---

<form
  action={accion}
  method="get"
  role="search"
  class:list={[
    'flex max-w-[540px] items-center gap-2 rounded-lg border p-1.5 transition-colors',
    oscuro
      ? 'border-white/25 bg-white/10 focus-within:border-white/60'
      : 'border-line-strong bg-white focus-within:border-accent',
    className,
  ]}
>
  <label for={id} class="sr-only">Buscar un examen en el catálogo</label>
  <Icon
    name="lupa"
    size={18}
    class:list={['ml-2.5 flex-none', oscuro ? 'text-white/75' : 'text-neutral']}
  />
  <input
    type="search"
    id={id}
    name="q"
    autocomplete="off"
    placeholder={placeholder}
    data-ejemplos={ejemplos ? JSON.stringify(ejemplos) : undefined}
    class:list={[
      'min-w-0 flex-1 bg-transparent py-2 text-sm focus:outline-none',
      oscuro ? 'text-white placeholder:text-white/90' : 'text-black placeholder:text-neutral',
    ]}
  />
  <button
    type="submit"
    class:list={[
      'min-h-11 flex-none rounded-md px-4 text-xs font-bold transition-colors',
      oscuro
        ? 'bg-white text-brand hover:bg-accent-soft'
        : 'bg-brand text-white hover:bg-accent-dark',
    ]}
  >
    {boton}
  </button>
</form>

<script>
  /*
    Placeholder «mecanografiado»: escribe un ejemplo letra a letra, espera,
    lo borra y pasa al siguiente. Se detiene en cuanto la persona escribe o
    enfoca el campo, y no arranca si el sistema pide menos movimiento.
  */
  const initEjemplos = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    for (const campo of document.querySelectorAll<HTMLInputElement>('input[data-ejemplos]')) {
      if (campo.dataset.ejemplosIniciado === 'true') continue;
      campo.dataset.ejemplosIniciado = 'true';

      let ejemplos: string[] = [];
      try {
        ejemplos = JSON.parse(campo.dataset.ejemplos ?? '[]');
      } catch {
        continue;
      }
      if (ejemplos.length === 0) continue;

      const fijo = campo.placeholder;
      const prefijo = 'Busque su examen: ';
      let indice = 0;
      let temporizador: number | undefined;

      /*
        `isConnected` es lo que corta la cadena al cambiar de página.

        Con las transiciones de página el `<body>` entero se sustituye, así que
        este campo queda fuera del documento pero la cadena de `setTimeout`
        sigue encadenándose. Sin esta comprobación no paraba nunca: en un campo
        separado, `document.activeElement` es el `<body>` y `value` sigue
        vacío, o sea que las otras dos condiciones se cumplían siempre. Cada
        visita a la portada dejaba otra cadena escribiendo ~20 veces por
        segundo sobre un elemento que ya no se ve.
      */
      const activo = () =>
        campo.isConnected && document.activeElement !== campo && campo.value === '';

      const escribir = (texto: string, pos: number, luego: () => void) => {
        if (!activo()) return detener();
        campo.placeholder = prefijo + texto.slice(0, pos) + (pos < texto.length ? '|' : '');
        if (pos < texto.length) {
          temporizador = window.setTimeout(() => escribir(texto, pos + 1, luego), 55 + Math.random() * 45);
        } else {
          temporizador = window.setTimeout(luego, 1600);
        }
      };

      const borrar = (texto: string, pos: number, luego: () => void) => {
        if (!activo()) return detener();
        campo.placeholder = prefijo + texto.slice(0, pos);
        if (pos > 0) temporizador = window.setTimeout(() => borrar(texto, pos - 1, luego), 28);
        else temporizador = window.setTimeout(luego, 350);
      };

      const ciclo = () => {
        const texto = ejemplos[indice % ejemplos.length]!;
        indice++;
        escribir(texto, 0, () => borrar(texto, texto.length, ciclo));
      };

      const detener = () => {
        if (temporizador !== undefined) window.clearTimeout(temporizador);
        temporizador = undefined;
        campo.placeholder = fijo;
      };

      const reanudar = () => {
        if (temporizador === undefined && activo()) ciclo();
      };

      campo.addEventListener('focus', detener);
      campo.addEventListener('blur', reanudar);
      campo.addEventListener('input', () => (campo.value ? detener() : reanudar()));

      // Empieza tras una pausa, cuando el resto de la portada ya asentó.
      temporizador = window.setTimeout(ciclo, 1800);
    }
  };

  initEjemplos();
  document.addEventListener('astro:page-load', initEjemplos);
</script>
