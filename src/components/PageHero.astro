---
/**
 * Cabecera compacta para las páginas internas.
 *
 * Con `foto`, el texto va a la izquierda y una foto real del laboratorio a la
 * derecha, en la misma proporción que el hero de la portada: así todas las
 * páginas abren con la misma presencia. Las clases `entrada-*` escalonan la
 * aparición del texto como en la portada.
 */
import FondoGotas from './FondoGotas.astro';
import PulsoEcg from './PulsoEcg.astro';
import { foto as fotoDe, type NombreFoto, SIZES_MEDIA_COLUMNA } from '@/lib/fotos';

interface Props {
  eyebrow?: string;
  titulo: string;
  descripcion?: string;
  migas?: { nombre: string; href: string }[];
  /**
   * Reduce la cabecera a lo mínimo. Para páginas que son una herramienta y no
   * un texto: en el catálogo, lo que el usuario viene a hacer es buscar, y un
   * titular a tamaño completo empuja el buscador fuera de la pantalla.
   */
  compacto?: boolean;
  /** Foto del laboratorio que acompaña al título (no se usa con `compacto`). */
  foto?: NombreFoto;
}

const { eyebrow, titulo, descripcion, migas = [], compacto = false, foto } = Astro.props;
const imagen = foto && !compacto ? fotoDe(foto) : undefined;
---

<section class="relative overflow-hidden bg-brand">
  <FondoGotas />
  {/* Trazo de ECG al pie, en blanco muy tenue: el pulso de la marca. */}
  <PulsoEcg class="h-20 text-white opacity-25" />
  <div
    class:list={[
      'container-page relative',
      compacto ? 'py-6 lg:py-8' : 'py-12 lg:py-16',
      imagen && 'grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-14',
    ]}
  >
    <div>
      {
        migas.length > 0 && (
          <nav
            aria-label="Ruta de navegación"
            class:list={['entrada entrada-1', compacto ? 'mb-3' : 'mb-6']}
          >
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/75">
              {migas.map((miga, i) => (
                <li class="flex items-center gap-2">
                  {i > 0 && <span aria-hidden="true">/</span>}
                  {i === migas.length - 1 ? (
                    <span class="text-white/85" aria-current="page">
                      {miga.nombre}
                    </span>
                  ) : (
                    <a
                      href={miga.href}
                      class="-my-1.5 inline-block py-1.5 transition-colors hover:text-accent-light"
                    >
                      {miga.nombre}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      {
        /*
          Sin icono: llevaba una gota fija en todas las páginas, dijera lo que
          dijera el texto. Un icono que no cambia con el contenido no informa.
        */
        eyebrow && !compacto && (
          <span class="entrada entrada-2 block text-xs font-bold tracking-[1.8px] text-accent-light uppercase">
            {eyebrow}
          </span>
        )
      }
      <h1
        class:list={[
          'entrada entrada-2 max-w-[760px] font-bold text-white',
          compacto ? 'text-h3' : 'mt-3 text-h1',
        ]}
      >
        {titulo}
      </h1>
      {
        descripcion && (
          <p
            class:list={[
              'entrada entrada-3 text-white/80',
              compacto ? 'mt-2 max-w-[70ch] text-sm' : 'mt-5 max-w-[620px] text-lead',
            ]}
          >
            {descripcion}
          </p>
        )
      }
      <div class:list={['entrada entrada-4', compacto ? 'mt-4' : 'mt-7', 'empty:mt-0']}>
        <slot />
      </div>
    </div>

    {
      imagen && (
        <div class="entrada-imagen relative overflow-hidden rounded-xl">
          <img
            {...imagen}
            sizes={SIZES_MEDIA_COLUMNA}
            fetchpriority="high"
            decoding="async"
            class="foto-viva h-[clamp(15rem,30vw,25rem)] w-full object-cover"
          />
        </div>
      )
    }
  </div>
</section>
