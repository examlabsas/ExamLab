---
/**
 * Banner de consentimiento de cookies (ítem 9 de la proforma).
 *
 * FASE 1: guarda la decisión en localStorage y no carga ningún script de
 * terceros. En la Fase 3, cuando se integren Analytics y el píxel de Facebook,
 * esos scripts deben cargarse únicamente si `examlab-cookies === "aceptadas"`.
 */
import Icon from './Icon.astro';
---

<div
  id="banner-cookies"
  hidden
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
  class="pointer-events-auto w-full border-t border-line bg-white px-4 pt-4 pb-4 shadow-[0_-8px_30px_rgb(0_90_140/0.12)] sm:px-6"
>
  <div class="container-page flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex items-start gap-3.5">
      <span
        class="hidden h-10 w-10 flex-none items-center justify-center rounded-lg bg-accent-soft text-accent-dark sm:flex"
      >
        <Icon name="escudo" size={20} />
      </span>
      <p class="max-w-[640px] text-sm leading-relaxed text-neutral">
        Hoy este sitio solo usa el almacenamiento imprescindible para funcionar: recordar esta
        decisión y la lista de exámenes que usted arme. No hay cookies de medición ni de
        publicidad. Si más adelante las añadimos, nos guiaremos por lo que elija aquí. Más
        detalles en nuestra <a
          href="/cookies"
          class="font-semibold text-accent-dark underline underline-offset-2 hover:text-brand"
          >política de cookies</a
        >.
      </p>
    </div>
    <div class="flex flex-col gap-2.5 sm:flex-row lg:flex-none">
      <button
        type="button"
        data-cookies="rechazar"
        class="rounded-xl border-[1.5px] border-line-strong bg-white px-5 py-3 text-sm font-bold text-brand transition-colors hover:border-accent"
      >
        Solo lo necesario
      </button>
      <button
        type="button"
        data-cookies="aceptar"
        class="min-h-11 rounded-xl bg-accent-dark px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-deep"
      >
        De acuerdo
      </button>
    </div>
  </div>
</div>

<script>
  const CLAVE = 'examlab-cookies';

  // El banner se vuelve a montar en cada navegación con transiciones de página.
  const initCookies = () => {
    const banner = document.getElementById('banner-cookies');
    // `astro:page-load` también corre en la carga inicial: sin la guarda se
    // registraría el listener dos veces.
    if (!banner || banner.dataset.iniciado === 'true') return;
    banner.dataset.iniciado = 'true';

    /*
      En navegación privada o con el almacenamiento bloqueado, leer lanza
      `SecurityError`. Sin el try/catch la función se cortaba aquí y el banner
      no llegaba a mostrarse nunca: nace con `hidden`. Ante la duda se muestra,
      que es el lado correcto en el que equivocarse.
    */
    let decidido = false;
    try {
      decidido = Boolean(localStorage.getItem(CLAVE));
    } catch {
      decidido = false;
    }

    if (decidido) {
      banner.hidden = true;
      return;
    }

    banner.hidden = false;

    for (const boton of banner.querySelectorAll<HTMLButtonElement>('[data-cookies]')) {
      boton.addEventListener('click', () => {
        const decision = boton.dataset.cookies === 'aceptar' ? 'aceptadas' : 'rechazadas';
        try {
          localStorage.setItem(CLAVE, decision);
        } catch {
          /* Sin almacenamiento la decisión vale solo para esta pantalla. */
        }
        banner.hidden = true;
        document.dispatchEvent(new CustomEvent('cookies:decision', { detail: decision }));
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookies);
  } else {
    initCookies();
  }
  document.addEventListener('astro:page-load', initCookies);
</script>
